    <script>
        document.getElementById('accountType').addEventListener('blur', function () {
            const accountType = this.value.trim();
        
            if (accountType === '') {
                return; // Do nothing if the input is empty
            }
        
            // Fetch data from the server
            fetch(`/check-account-type?accountType=${encodeURIComponent(accountType)}`)
                .then(response => response.json())
                .then(data => {
                    const savingElements = [
                        'collateral', 'installment', 'aploanamt', 'duration',
                        'balTransAcc', 'balTransName', 'AccEngName'
                    ];
                    const loanElements = ['overDraftAmt', 'minBalance', 'complusorySaving'];
        
                    const toggleElements = (elements, isDisabled) => {
                        elements.forEach(id => {
                            const element = document.getElementById(id);
                            if (element) {
                                element.style.pointerEvents = isDisabled ? 'none' : '';
                                element.style.color = isDisabled ? 'gray' : '';
                            }
                        });
                    };
        
                    if (data.savingOrLoan === 'Saving') {
                        toggleElements(savingElements, true);
                        toggleElements(loanElements, false);
                    } else if (data.savingOrLoan === 'Loan') {
                        toggleElements(savingElements, false);
                        toggleElements(loanElements, true);
                    }
                })
                .catch(error => {
                    console.error('Error fetching account type:', error);
                });
        });
    </script>
    
    <script>
        document.getElementById('IntTransfer').addEventListener('blur', function () {
          const alias = this.value;
          if (alias.trim() === '') {
            document.getElementById('TransferName').value = '';
            return;
          }
      
          fetch('/get-member-alias-1', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ alias }),
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.success) {
                document.getElementById('TransferName').value = data.memberName || '';
              } else {
                showCustomAlert(data.message || 'Alias not found');
              }
            })
            .catch((error) => {
              console.error('Error:', error);
            });
        });
      </script>

