   <script>
    let allCollectors = [];  // Array to store all collector data
let filteredCollectors = [];  // Array to store filtered collector data

// Fetch collector data and show suggestions
function fetchCollectors(isInitialFocus) {
    const collectorsList = document.getElementById('PCollectorsList');  // Corrected to PCollectorsList
    const inputField = document.getElementById('PCollector');
    collectorsList.innerHTML = '';  // Clear previous suggestions
    collectorsList.style.display = 'none';  // Hide the list initially

    if (allCollectors.length === 0 || isInitialFocus) {
        fetch('/fetchcollectors')  // Fetch from the '/fetchcollectors' endpoint
            .then(response => response.json())
            .then(data => {
                if (data.collectors && data.collectors.length > 0) {
                    allCollectors = data.collectors;  // Store all collectors in allCollectors
                    filteredCollectors = [...allCollectors];  // Copy to filteredCollectors
                    displayCollectors(filteredCollectors);
                } else {
                    const noResult = document.createElement('div');
                    noResult.textContent = 'No collectors found';
                    noResult.style.color = 'gray';
                    collectorsList.appendChild(noResult);
                }
            })
            .catch(error => {
                console.error('Error fetching collectors:', error);
                const errorMessage = document.createElement('div');
                errorMessage.textContent = 'Error fetching collectors';
                errorMessage.style.color = 'red';
                collectorsList.appendChild(errorMessage);
            });
    } else {
        displayCollectors(filteredCollectors);  // Use filteredCollectors when available
    }
}

// Filter collectors based on user input
function filterCollectors() {
    const input = document.getElementById('PCollector').value.toLowerCase();  // Corrected to PCollector
    if (input === '') {
        filteredCollectors = [...allCollectors];  // Reset filteredCollectors to allCollectors
    } else {
        filteredCollectors = allCollectors.filter(item =>
            item.CollectorName.toLowerCase().includes(input) || item.CollectorAlias.toLowerCase().includes(input)
        );
    }
    displayCollectors(filteredCollectors);
}

// Display the filtered collectors in the suggestions list
function displayCollectors(collectors) {
    const collectorsList = document.getElementById('PCollectorsList');  // Corrected to PCollectorsList
    collectorsList.innerHTML = '';  // Clear previous suggestions

    // Sort the collectors alphabetically by CollectorName
    collectors.sort((a, b) => a.CollectorName.localeCompare(b.CollectorName));

    const closeButton = document.createElement('button');
    closeButton.textContent = 'X';
    closeButton.className = 'close-button';

    closeButton.onclick = function (event) {
        event.preventDefault();
        collectorsList.style.display = 'none';  // Hide the suggestions list
    };

    collectorsList.appendChild(closeButton);  // Append the close button

    if (collectors.length > 0) {
        collectorsList.style.display = 'block';  // Show the suggestions list
        collectors.forEach(item => {
            const div = document.createElement('div');
            div.className = 'suggestion-item';
            div.textContent = `${item.CollectorName} - ${item.CollectorAlias}`;
            div.title = `${item.CollectorName} - ${item.CollectorAlias}`;

            div.onclick = function () {
                document.getElementById('PCollector').value = item.CollectorName;  // Corrected to PCollector
                collectorsList.style.display = 'none';  // Hide the suggestions list
            };
            collectorsList.appendChild(div);
        });
    } else {
        const noResult = document.createElement('div');
        noResult.textContent = 'No matching collectors found';
        noResult.style.color = 'gray';
        collectorsList.appendChild(noResult);
    }
}

