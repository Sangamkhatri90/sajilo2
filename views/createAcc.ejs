    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const memberIdInput = document.getElementById('MemberId');
    
            // Fetch and populate data on page load
            fetchData(memberIdInput.value);
    
            // Event listener for when the input is clicked or loses focus
            memberIdInput.addEventListener('click', () => fetchData(memberIdInput.value));
            memberIdInput.addEventListener('blur', () => fetchData(memberIdInput.value));
    
            async function fetchData(memberAlias) {
                try {
                    const response = await fetch(`/fetch-member-data?memberAlias=${memberAlias}`);
                    if (response.ok) {
                        const { memberData, subLedgerData } = await response.json();
    
                        // Populate the form fields
                        document.querySelector('[name="MemberName"]').value = memberData.MemberName || '';
                        document.querySelector('[name="SLName"]').value = subLedgerData.SLName || '';
                        document.querySelector('[name="NextofKinName"]').value = memberData.NextofKinName || '';
                        document.querySelector('[name="NextofKinAddress"]').value = memberData.NextofKinAddress || '';
                        document.querySelector('[name="DateofBirth"]').value = memberData.DateofBirth || '';
                        document.querySelector('[name="Address1"]').value = subLedgerData.Address1 || '';
                        document.querySelector('[name="Phone1"]').value = subLedgerData.Phone1 || '';
                        document.querySelector('[name="Relation"]').value = memberData.Relation || '';
                        document.querySelector('[name="Mobile"]').value = memberData.Mobile || '';
                        document.getElementById('Gender').value = memberData.Sex || 'Male';
                        document.querySelector('[name="NextofKinContactNumber"]').value = memberData.NextofKinContactNumber || '';
                    } else {
                        console.error('Error fetching data:', await response.json());
                    }
                } catch (err) {
                    console.error('Error:', err.message);
                }
            }
        });
    </script>
    

