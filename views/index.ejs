    <script>
        window.addEventListener("load", () => {
            const navEntries = performance.getEntriesByType("navigation");
            const reloaded = navEntries.length && navEntries[0].type === "reload";

            const sessionDiv = document.getElementById("movableDiv81");
            const sessionFlag = sessionDiv?.dataset.sessionExpired || sessionStorage.getItem("sessionExpired");

            // Only redirect if modal not shown and no session flag
            if (reloaded && !sessionFlag) {
                console.warn("Fallback redirect triggered due to missing session.");
                window.location.href = "/index.html"; // login page
            }
        });
    </script>


    <style>
        #connection-status-banner {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background-color: #ff4d4d;
            /* Red for offline */
            color: white;
            text-align: center;
            padding: 15px 10px;
            font-weight: bold;
            font-family: Arial, sans-serif;
            display: none;
            z-index: 9999;
            box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.3);
        }

        #connection-status-banner.online {
            background-color: #4CAF50;
            /* Green for online */
        }
    </style>

    <div id="connection-status-banner">
        Your internet connection seems to be interrupted, so some features and services will not be available although
        some features seem to be running.<br>
        It is recommended to check your internet connection.
    </div>

    <script>
        const banner = document.getElementById('connection-status-banner');

        function updateOnlineStatus() {
            if (navigator.onLine) {
                banner.textContent = "Internet connection restored.";
                banner.classList.add('online');
                banner.style.display = 'block';
                // Hide banner after 3 seconds
                setTimeout(() => {
                    banner.style.display = 'none';
                    banner.classList.remove('online');
                }, 3000);
            } else {
                banner.innerHTML = `
        Your internet connection seems to be interrupted, so some features and services will not be available although some features seem to be running.<br>
        It is recommended to check your internet connection.
      `;
                banner.classList.remove('online');
                banner.style.display = 'block';
                // Hide banner after 3 seconds
                setTimeout(() => {
                    banner.style.display = 'none';
                    banner.classList.remove('online');
                }, 10000);
            }
        }

        window.addEventListener('online', updateOnlineStatus);
        window.addEventListener('offline', updateOnlineStatus);

        // Initial check on page load
        if (!navigator.onLine) {
            updateOnlineStatus();
        }
    </script>

