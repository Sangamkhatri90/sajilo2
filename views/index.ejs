                        div.textContent = item;
                        div.title = item;
                        div.style.padding = '6px';
                        div.style.cursor = 'pointer';
                        div.addEventListener('click', () => {
                            activeCellDENew.textContent = item;
                            dropdownDENew.style.display = 'none';
                        });
                        div.addEventListener('mouseover', () => div.style.background = '#f1f1f1');
                        div.addEventListener('mouseout', () => div.style.background = 'transparent');
                        optionsContainerDENew.appendChild(div);
                    });
                }

                // Search filter
                searchDENew.addEventListener('input', () => {
                    const query = searchDENew.value.toLowerCase();
                    const filtered = currentOptionsDENew.filter(opt => opt.toLowerCase().includes(query));
                    renderDropdownOptionsDENew(filtered);
                });

                // Close button
                closeDropdownDENew.addEventListener('click', () => {
                    dropdownDENew.style.display = 'none';
                });

                // Hide dropdown when clicking outside
                document.addEventListener('click', (e) => {
                    if (!dropdownDENew.contains(e.target) && e.target !== activeCellDENew) {
                        dropdownDENew.style.display = 'none';
                    }
                });

                // Initialize for both tables
                initTableDropdownDENew('rv-new-table');
                initTableDropdownDENew('jv-new-table');
                initTableDropdownDENew('pv-new-table');
                initTableDropdownDENew('mbv-new-table');
