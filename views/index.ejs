                <script>
                    // Function to show the popup with the table
                    document.addEventListener("DOMContentLoaded", function () {

                        const okButton = document.getElementById("BankRS-ok-button");

                        const brsresult = document.getElementById("popupTableDiv"); // retrieving the value

                        let ExcelData = null;
                        let sessionnExcelData = null;
                        let highestZIndex = 3;

                        function bringToFront(element) {
                            highestZIndex++;
                            element.style.zIndex = highestZIndex;
                        }

                        function makeDivMovable(div) {
                            let isDragging = false;
                            let offsetX, offsetY;

                            div.addEventListener('mousedown', (e) => {
                                if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
                                    return; // Allow interaction with input fields
                                }
                                e.preventDefault();
                                bringToFront(div);

                                const rect = div.getBoundingClientRect();
                                offsetX = e.clientX - rect.left;
                                offsetY = e.clientY - rect.top;

                                isDragging = true;
                            });

                            document.addEventListener('mousemove', (e) => {
                                if (isDragging) {
                                    div.style.left = `${e.pageX - offsetX}px`;
                                    div.style.top = `${e.pageY - offsetY}px`;
                                    div.style.position = 'absolute';
                                }
                            });

                            document.addEventListener('mouseup', () => {
                                isDragging = false;
                            });
                        }

                        makeDivMovable(brsresult);




                        /* ---------- Excelfile input ---------- */
                        const selectFileBtninBRS = document.getElementById("selectFileBtninFRBRS");
                        const excelFileInputinBRS = document.getElementById("excelFileInputinFRBRS");


                        selectFileBtninBRS.addEventListener("click", () => {
                            console.log('selectFileBtninBRS clicked');
                            excelFileInputinBRS.click();

                        });

                        excelFileInputinBRS.addEventListener("change", function (e) {
                            console.log('excelFileInputinBRS chcnged');
                            const file = e.target.files[0];
                            const reader = new FileReader();
                            reader.onload = function (e) {
                                const workbook = XLSX.read(e.target.result, { type: 'binary' });
                                const sheet1 = workbook.Sheets['TbLedgderMaster'];
                                console.log('Bpp', sheet1)
                                const sheet2 = workbook.Sheets['TbSubledgerMaster']
                                if (!sheet1 || !sheet2) return showCustomAlert("Sheet not found.");
                                const jsonData1 = XLSX.utils.sheet_to_json(sheet1);
                                sessionnExcelData = jsonData1.map(row => ({
                                    particular: row.GLName || '',
                                    alias: row.GlAlias || '',
                                    openingDebit: parseFloat(row.OpeningBalanceDr || 0),
                                    openingCredit: parseFloat(row.OpeningBalanceCr || 0)
                                }));

                                showCustomAlert("Excel file loaded. Click OK to load the table.");
                            };
                            reader.readAsBinaryString(file);
                        });









                        okButton.addEventListener("click", async function (event) {
                            event.preventDefault();
                            // Get the value from the "Bank Book" input field
                            const bankBookValue = document.getElementById('bank-name-input').value;
                            const fromDate = document.getElementById("BRSdateFrom").value;
                            const toDate = document.getElementById("BRSdateTo").value;

                            if (!sessionnExcelData) {
                                return showCustomAlert(" Excel sheets required (Account Head ).");
                            }

                            let formattedfromDate = '';
                            if (fromDate) {
                                // Check if the input is in 'YYYY-DD-MM' format
                                if (fromDate.includes('-')) {
                                    const dateParts = fromDate.split('-'); // Split by hyphens
                                    formattedfromDate = `${dateParts[0]}/${dateParts[1]}/${dateParts[2]}`; // Convert to 'YYYY/MM/DD'

                                } else {
                                    formattedfromDate = fromDate; // If not in expected format, return as-is or handle accordingly
                                }
                            }



                            let formattedtoDate = '';
                            if (toDate) {
                                // Check if the input is in 'YYYY-DD-MM' format
                                if (toDate.includes('-')) {
                                    const dateParts = toDate.split('-'); // Split by hyphens
                                    formattedtoDate = `${dateParts[0]}/${dateParts[1]}/${dateParts[2]}`; // Convert to 'YYYY/MM/DD'

                                } else {
                                    formattedtoDate = toDate; // If not in expected format, return as-is or handle accordingly
                                }
                            }



                            // Fetch the totals from the backend by sending the Bank Book name
                            // Use POST instead of GET to send large JSON
                            console.log("Sending BBV to BE", bankBookValue);
                            try {
                                const response = await fetch('/fetchTotalAmountsForBRS', {
                                    method: 'POST',
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({
                                        bankBookName: bankBookValue,
                                        fromDate: formattedfromDate,
                                        toDate: formattedtoDate,
                                        excelData: sessionnExcelData
                                    })
                                });

                                if (!response.ok) {
                                    throw new Error(`HTTP error! Status: ${response.status}`);
                                }

                                const data = await response.json();

                                const totalDrAmount = data.totalDrAmount || 0;
                                const totalCrAmount = data.totalCrAmount || 0;
                                const addSubRows = data.addSubRows || [];
                                const lessSubRows = data.lessSubRows || [];

                                // Calculate the Amount (CrAmount - DrAmount)
                                let amount = totalCrAmount - totalDrAmount;
                                let amountDisplay = amount < 0
                                    ? `${Math.abs(amount).toFixed(2)} Dr`
                                    : `${amount.toFixed(2)} Cr`;

                                const popupTableDiv = document.getElementById("popupTableDiv");
                                popupTableDiv.style.display = "block";

                                const tableBody = document.querySelector('#popupTableDiv table tbody');
                                tableBody.innerHTML = ''; // Clear any existing rows

                                // Row 1
                                const row1 = document.createElement('tr');
                                row1.innerHTML = `
        <td class="no-border"><strong>${bankBookValue}</strong></td>
        <td class="no-border"></td>
        <td class="no-border"></td>
        <td class="no-border"></td>
        <td class="no-border"></td>
        <td class="no-border"></td>
        <td class="no-border"></td>
    `;
                                tableBody.appendChild(row1);

                                // Row 2
                                const row2 = document.createElement('tr');
                                row2.innerHTML = `
        <td class="hide-column"><strong>BankCash/BankBook</strong></td>
        <td class="hide-column"></td>
        <td class="hide-column"></td>
        <td class="hide-column"></td>
        <td class="hide-column"></td>
        <td class="hide-column"></td>
        <td><strong>${amountDisplay}</strong></td>
    `;
                                tableBody.appendChild(row2);

                                // ADD section
                                const addHeaderRow = document.createElement('tr');
                                addHeaderRow.innerHTML = `
        <td colspan="6"><strong>ADD(+): CHEQUE ISSUED BUT NOT PRESENTED</strong></td>
        <td></td>
    `;
                                tableBody.appendChild(addHeaderRow);

                                let addTotal = 0;
                                addSubRows.forEach(sub => {
                                    const row = document.createElement('tr');
                                    row.innerHTML = `
            <td>${sub.label}</td>
            <td>${sub.glalias}</td>
            <td>${sub.chequeno || ''}</td>
            <td>${sub.chequedate || ''}</td>
            <td>${sub.voucherno || ''}</td>
            <td>${sub.jv_miti || ''}</td>
            <td>${sub.amount}</td>
        `;
                                    tableBody.appendChild(row);
                                    addTotal += parseFloat(sub.amount);
                                });

                                const addTotalRow = document.createElement('tr');
                                addTotalRow.innerHTML = `
        <td colspan="6"><strong>Total of Cheques Issued</strong></td>
        <td id="add-total-amount"><strong>${addTotal.toFixed(2)}</strong></td>
    `;
                                tableBody.appendChild(addTotalRow);

                                // LESS section
                                const lessHeaderRow = document.createElement('tr');
                                lessHeaderRow.innerHTML = `
        <td colspan="6"><strong>LESS(-): CHEQUE DEPOSITED BUT NOT CLEARED</strong></td>
        <td></td>
    `;
                                tableBody.appendChild(lessHeaderRow);

                                let lessTotal = 0;
                                lessSubRows.forEach(sub => {
                                    const row = document.createElement('tr');
                                    row.innerHTML = `
            <td>${sub.label}</td>
            <td>${sub.glalias}</td>
            <td>${sub.chequeno || ''}</td>
            <td>${sub.chequedate || ''}</td>
            <td>${sub.voucherno || ''}</td>
            <td>${sub.jv_miti || ''}</td>
            <td>${sub.amount}</td>
        `;
                                    tableBody.appendChild(row);
                                    lessTotal += parseFloat(sub.amount);
                                });

                                const lessTotalRow = document.createElement('tr');
                                lessTotalRow.innerHTML = `
        <td colspan="6"><strong>Total of Deposits Not Cleared</strong></td>
        <td id="less-total-amount"><strong>${lessTotal.toFixed(2)}</strong></td>
    `;
                                tableBody.appendChild(lessTotalRow);

                                // ACTUAL BALANCE row
                                const actualBalanceValue = amount + addTotal - lessTotal;
                                const actualBalanceDisplay = actualBalanceValue < 0
                                    ? `${Math.abs(actualBalanceValue).toFixed(2)} Dr`
                                    : `${actualBalanceValue.toFixed(2)} Cr`;

                                const actualBalanceRow = document.createElement('tr');
                                actualBalanceRow.innerHTML = `
        <td colspan="6"><strong>ACTUAL BALANCE</strong></td>
        <td id="actual-balance"><strong>${actualBalanceDisplay}</strong></td>
    `;
                                tableBody.appendChild(actualBalanceRow);

                                // Close & Export handlers
                                document.getElementById("brs-tb-okbutton").onclick = () => popupTableDiv.style.display = "none";
                                document.getElementById("brs-tb-exportbutton").onclick = () => {
                                    const rows = document.querySelectorAll("table tr");
                                    const csvData = Array.from(rows).map(row =>
                                        Array.from(row.querySelectorAll("td, th")).map(cell => cell.innerText).join(",")
                                    ).join("\n");
                                    const blob = new Blob([csvData], { type: 'text/csv;charset=utf-8;' });
                                    const link = document.createElement('a');
                                    link.href = URL.createObjectURL(blob);
                                    link.download = 'table_data.csv';
                                    link.click();
                                };
                                document.getElementById("closeTableButton").onclick = () => popupTableDiv.style.display = "none";

                            } catch (error) {
                                console.error('Error fetching data:', error);
                            }

                        });
                    });

                </script>

