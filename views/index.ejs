            <script>
                let selectedShareIssue = null; // To store the selected share issue

                // Fetch share issues from the backend
                function showShareIssuesList() {
                    const shareIssueListDiv = document.getElementById('ShareIssueList');
                    shareIssueListDiv.innerHTML = ''; // Clear any existing content
                    shareIssueListDiv.style.display = 'none'; // Hide the list initially

                    fetch('/fetchShareIssue')
                        .then(response => response.json())
                        .then(data => {
                            if (data.shareIssues && data.shareIssues.length > 0) {
                                displayShareIssues(data.shareIssues);
                            } else {
                                const noResult = document.createElement('div');
                                noResult.textContent = 'No share issues found';
                                shareIssueListDiv.appendChild(noResult);
                            }
                        })
                        .catch(error => {
                            console.error('Error fetching share issues:', error);
                            const errorMessage = document.createElement('div');
                            errorMessage.textContent = 'Error fetching share issues';
                            shareIssueListDiv.appendChild(errorMessage);
                        });
                }

                // Display fetched share issues in a list
                function displayShareIssues(shareIssues) {
                    const shareIssueListDiv = document.getElementById('ShareIssueList');
                    shareIssueListDiv.innerHTML = ''; // Clear previous suggestions

                    // Create an "X" button to close the list
                    const closeButton = document.createElement('button');
                    closeButton.textContent = 'X';
                    closeButton.className = 'close-button'; // You can style it with this class
                    closeButton.onclick = function (event) {
                        event.preventDefault();  // Prevent default action
                        shareIssueListDiv.style.display = 'none'; // Hide the share issue list
                    };

                    shareIssueListDiv.appendChild(closeButton); // Add the close button to the list

                    // Sort share issues alphabetically based on GenerateNo (if necessary)
                    shareIssues.sort((a, b) => a.GenerateNo.localeCompare(b.GenerateNo));

                    shareIssueListDiv.style.display = 'block'; // Show the suggestions list

                    // Loop through each share issue and create a suggestion item
                    shareIssues.forEach(shareIssue => {
                        const div = document.createElement('div');
                        div.className = 'suggestion-item';
                        div.textContent = `${shareIssue.GenerateNo} - ${shareIssue.GenerateDate}`; // Display both GenerateNo and GenerateDate

                        // When a share issue is clicked, fill the input fields
                        div.onclick = function () {
                            // Assuming shareIssue.GenerateDate is in a format like "2025-02-18" or "02/18/2025"
                            // Convert date to "YYYY-MM-DD" format (if needed)
                            const formattedDate = formatDate(shareIssue.GenerateDate); // Call the formatDate function

                            // Populate the input fields with the selected share issue data
                            document.getElementById('Shareissue-generate-date').value = formattedDate; // Set the date field
                            document.getElementById('Shareissue-GenerateCode').value = shareIssue.GenerateNo; // Set the Generate Code field
                            selectedShareIssue = shareIssue;  // Store the selected share issue
                            shareIssueListDiv.style.display = 'none'; // Hide the suggestion list
                        };

                        // Function to format date to "YYYY-MM-DD"
                        function formatDate(dateString) {
                            const date = new Date(dateString);
                            const year = date.getFullYear();
                            const month = String(date.getMonth() + 1).padStart(2, '0'); // Ensure 2 digits
                            const day = String(date.getDate()).padStart(2, '0'); // Ensure 2 digits

                            return `${year}-${month}-${day}`; // Return in YYYY-MM-DD format
                        }

                        shareIssueListDiv.appendChild(div);
                    });
                }

                // Delete share issue
                function deleteShareIssue() {
                    const shareIssueId = document.getElementById('Shareissue-GenerateCode').value.trim();
                    const shareIssueAlias = document.getElementById('Shareissue-generate-date').value.trim();

                    // If no share issue is selected and no input values are filled, show the share issue list
                    if (!selectedShareIssue && !shareIssueId) {
                        showShareIssuesList(); // Show the share issue list to choose from
                        return;
                    }

                    // If no share issue is selected, alert the user and return
                    if (!selectedShareIssue && !shareIssueId) {
                        showCustomAlert("Please select a share issue first.");
                        return; // Prevent deletion if no share issue is selected
                    }

                    const shareIssueToDelete = selectedShareIssue ? selectedShareIssue.GenerateNo : shareIssueId;

                    if (!shareIssueToDelete) {
                        showCustomAlert("Share Issue and Alias are required.");
                        resetSelection9();
                        return; // Prevent deletion if no share issue is selected
                    }

                    // Step 1: Check if the share issue can be deleted
                    checkDeletionPermission(shareIssueToDelete);
                }

                // Function to check if the share issue can be deleted
                function checkDeletionPermission(shareIssueName) {
                    fetch('/checkDeletionPermission', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ shareIssueName: shareIssueName })
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // If deletion is allowed, proceed to delete
                                deleteShareIssueFromBackend(shareIssueName);
                            } else {
                                // If not allowed, show message
                                showCustomAlert(data.message || "Deletion not allowed.");
                                resetSelection9();
                            }
                        })
                        .catch(error => {
                            console.error('Error checking deletion permission:', error);
                            showCustomAlert("Error checking deletion permission.");
                            resetSelection9();
                        });
                }

                // Function to delete share issue from backend after checking
                function deleteShareIssueFromBackend(shareIssueName) {
                    showCustomConfirm(
                        `Are you sure you want to delete the shareIssueName "${shareIssueName}"?`,
                        () => {
                            fetch('/deleteShareIssue', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ shareIssueName: shareIssueName })
                            })
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success) {
                                        showCustomAlert(`Share issue "${shareIssueName}" deleted successfully.`);
                                        removeFromList(shareIssueName); // Remove the deleted share issue from the list
                                        resetSelection9(); // Reset the form and selection after successful deletion
                                    } else {
                                        showCustomAlert(data.message || "Failed to delete the share issue.");
                                        resetSelection9();
                                    }
                                })
                                .catch(error => {
                                    console.error('Error deleting share issue:', error);
                                    showCustomAlert("Error deleting share issue.");
                                    resetSelection9();
                                });
                        },
                        () => {
                            // On cancel
                            resetSelection9();
                        }
                    );
                }

                // Remove the deleted share issue from the displayed list
                function removeFromList(shareIssueName) {
                    const shareIssueListDiv = document.getElementById('ShareIssueList');
                    const items = shareIssueListDiv.querySelectorAll('.suggestion-item');
                    items.forEach(item => {
                        if (item.textContent.includes(shareIssueName)) {
                            item.remove();
                        }
                    });
                }

                // Reset selection and input fields (renamed to resetSelection9)
                function resetSelection9() {
                    selectedShareIssue = null;
                    document.getElementById('Shareissue-generate-date').value = '';
                    document.getElementById('Shareissue-GenerateCode').value = '';
                    const shareIssueListDiv = document.getElementById('ShareIssueList');
                    shareIssueListDiv.innerHTML = '';
                    shareIssueListDiv.style.display = 'none';
                }
            </script>
