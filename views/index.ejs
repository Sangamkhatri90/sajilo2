            <script>
                // GLOBAL VARIABLES
                let deleteMode = false;
                let selectedUDFID = null;

                // ---------------------------------------------
                // CLICK DELETE BUTTON
                // ---------------------------------------------
                document.getElementById("UDFDeleteBtn").addEventListener("click", async () => {
                    if (!deleteMode) {
                        deleteMode = true;

                        const hasData = await loadUDFDeleteList(); // returns true/false

                        if (!hasData) {
                            deleteMode = false;
                            return;
                        }

                        document.getElementById("udfListdiv").style.display = "block";
                        document.getElementById("UDFDeleteBtn").innerText = "Delete Mode (Select Item)";
                    }
                });


                // -----------------------------------------------------------
                // LOAD LIST FROM DATABASE
                // -----------------------------------------------------------
                async function loadUDFDeleteList() {
                    const listDiv = document.getElementById("udfListdiv");
                    listDiv.innerHTML = "";

                    const rows = await fetch("/udf/loadDeleteList").then(r => r.json());

                    if (!rows || rows.length === 0) {
                        showCustomAlert("No values to delete!");
                        return false; // <-- important
                    }

                    rows.forEach(row => {
                        const item = document.createElement("div");
                        item.classList.add("suggestion-item");
                        item.style.cursor = "pointer";
                        item.style.padding = "5px";

                        item.textContent = `${row.Module} - ${row.Name}`;

                        // USER CLICKS ONE ITEM
                        item.addEventListener("click", async () => {
                            selectedUDFID = row.UDFID;

                            loadUDFIntoForm(row.UDFID);

                            // Confirm delete
                            const confirmDelete = showCustomConfirm(`Do you want to delete "${row.Name}"?`);

                            if (confirmDelete) {
                                await deleteUDF(row.UDFID);
                            }
                        });

                        listDiv.appendChild(item);
                    });

                    return true; // data available
                }


                // -----------------------------------------------------------
                // DELETE FUNCTION
                // -----------------------------------------------------------
                async function deleteUDF(id) {
                    await fetch(`/udf/delete/${id}`, { method: "DELETE" });

                    showCustomAlert("Deleted Successfully!");

                    // Reset delete mode
                    deleteMode = false;
                    selectedUDFID = null;
                    document.getElementById("udfListdiv").style.display = "none";
                    document.getElementById("UDFDeleteBtn").innerText = "Delete";
                    document.getElementById("myForm186").reset();
                }


                // -----------------------------------------------------------
                // FILL FORM WHEN LIST ITEM CLICKED
                // -----------------------------------------------------------
                async function loadUDFIntoForm(id) {
                    const data = await fetch(`/udf/getById/${id}`).then(r => r.json());

                    document.getElementById("UDFField").value = data.Name;
                    document.getElementById("UDFHidden").value = data.UDFID;
                    document.getElementById("UDFLength").value = data.Length;
                    document.getElementById("UDForder").value = data.SortOrder;
                    document.getElementById("UDFremark").value = data.Remarks;

                    document.getElementById("UDFModule").value = data.Module;
                    document.getElementById("UDFType").value = data.Type;

                    document.getElementById("UDFDecimalCB").checked = data.AllowDecimal == 1;
                    document.getElementById("UDFItemwiseCB").checked = data.ItemWise == 1;
                    document.getElementById("UDFShowTotalCB").checked = data.ShowTotal == 1;
                    document.getElementById("UDFMandatoryCB").checked = data.Mandatory == 1;
                    document.getElementById("UDFActiveCB").checked = data.Status == 1;
                }


            </script>

