                // FETCH LIST FOR EDIT
                function showUDFsListForEdit() {

                    const udfListDiv = document.getElementById('udfListdiv');
                    udfListDiv.innerHTML = "";
                    udfListDiv.style.display = "none";

                    fetch("/fetchUDFSForEdit")
                        .then(res => res.json())
                        .then(data => {
                            if (data.UDF && data.UDF.length > 0) {
                                displayUDFSForEdit(data.UDF);
                            } else {
                                udfListDiv.innerHTML = "<div style='color:gray'>No UDFs found</div>";
                            }
                        })
                        .catch(err => {
                            udfListDiv.innerHTML = "<div style='color:red'>Error fetching UDFs</div>";
                        });
                }



                // DISPLAY LIST
                function displayUDFSForEdit(UDFs) {

                    const udfListDiv = document.getElementById('udfListdiv');
                    udfListDiv.innerHTML = "";

                    // Close button
                    const closeButton = document.createElement('button');
                    closeButton.textContent = "X";
                    closeButton.className = "close-button";
                    closeButton.onclick = () => udfListDiv.style.display = "none";
                    udfListDiv.appendChild(closeButton);

                    // Filter + Sort
                    const validUDFs = UDFs.filter(u => u.Module && typeof u.Module === "string")
                        .sort((a, b) => a.Module.toLowerCase().localeCompare(b.Module.toLowerCase()));

                    if (validUDFs.length === 0) {
                        udfListDiv.innerHTML += "<div style='color:gray'>No UDFs found</div>";
                        return;
                    }

                    udfListDiv.style.display = "block";

                    validUDFs.forEach(UDF => {

