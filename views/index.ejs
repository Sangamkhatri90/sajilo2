                        const editdocemail = document.getElementById("docclass-email").value;
                        const editdocpan = document.getElementById("docclass-panNo").value;
                        const editdocincometaxno = document.getElementById("docclass-income").value;
                        const editdocremark = document.getElementById("editdocclassRemark").value;


                        // Send the data to the backend via a POST request using fetch
                        fetch('/update-doc-class', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                editdocname,
                                editselecteddocname,
                                editdocAlias,
                                editdocaddress1,
                                editdocaddress2,
                                editdocphone1,
                                editdocphone2,
                                editdocfax,
                                editdocemail,
                                editdocpan,
                                editdocincometaxno,
                                editdocremark
                            })
                        })
                            .then(response => response.json())
                            .then(result => {
                                // Handle the response from the backend
                                if (result.success) {
                                    showCustomAlert(result.message);  // Show success message
                                    // Clear the form inputs after successful submission
                                    document.getElementById('myForm80').reset();  // Resets the form inputs
                                    // Optionally, hide the edit form
                                    document.getElementById('movableDiv80').style.display = 'none';
                                } else {
                                    showCustomAlert('Error: ' + result.message);  // Show error message
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);  // Log any errors
                                showCustomAlert('An error occurred while updating the document class.');
                            });
                    });

                    // Handle Cancel button to close the form without saving
                    document.getElementById('cancelButton80').addEventListener('click', function () {
                        // Display a confirmation message
                        const confirmCancel = window.showCustomConfirm("Do you want to cancel without saving?");

                        if (confirmCancel) {
                            // If the user clicks "OK", the form remains open
                            document.getElementById('movableDiv80').style.display = 'none'; // Hide the form
                            console.log('User confirmed cancellation. The form remains open.');
                        } else {
                            // If the user clicks "Cancel", hide the form and reset the form inputs
                            document.getElementById('movableDiv80').style.display = 'block'; // Hide the form
                            document.getElementById('myForm80').reset();  // Reset form inputs
                            console.log('User canceled the action. The form is closed.');
                        }
                    });

