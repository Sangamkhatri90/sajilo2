        <td style="background:#e6f0ff"></td>
        <td style="background:#e6f0ff"></td>
        <td style="background:#e6f0ff"></td>
        <td style="background:#e6f0ff"></td>
      `;
                                renderedSubGroups.add(subGroupKey);
                            }

                            // 3️⃣ Render Ledger
                            const row = table.insertRow();
                            row.innerHTML = `
      <td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${item.particular || ''}</td>
      <td>${item.alias || ''}</td>
      <td style="text-align:right;">${openingDr.toFixed(2)}</td>
      <td style="text-align:right;">${openingCr.toFixed(2)}</td>
      <td style="text-align:right;">${periodDr.toFixed(2)}</td>
