            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const form = document.getElementById('searchForm');
                    const aliasInput = document.getElementById('alias');
                    const checkbox = document.getElementById('autoformatmemberalias');
                    const suggestionBox = document.getElementById('suggestionBox');
                    const suggestionBoxXbtn = document.getElementById('suggestionBoxXbutton');
                    const suggestionList = document.getElementById('suggestionList');

                    let allSuggestions = [];
                    let typingTimeout = null;
                    let aliasLength = 7; // default

                    async function fetchAliasLength() {
                        try {
                            const res = await fetch('/api/membersearchdigitcheck');
                            const data = await res.json();
                            aliasLength = parseInt(data.bodyLength) || 7;
                        } catch (err) {
                            console.warn("⚠️ Using default alias length (7) due to error:", err);
                        }
                    }
                    fetchAliasLength();

                    function formatAlias(val) {
                        return val.toString().padStart(aliasLength, '0');
                    }

                    async function fetchSuggestions(partial) {
                        const res = await fetch('/api/suggestionmemberalias', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ partial })
                        });
                        const data = await res.json();
                        return data;
                    }

                    aliasInput.addEventListener('input', async () => {
                        const val = aliasInput.value;
                        clearTimeout(typingTimeout);

                        if (!val) {
                            suggestionBox.style.display = 'none';
                            return;
                        }

                        typingTimeout = setTimeout(async () => {
                            aliasInput.value = formatAlias(val);

                            if (checkbox.checked) {
                                suggestionBox.style.display = 'none';
                                return;
                            }

                            const suggestions = await fetchSuggestions(val);
                            allSuggestions = suggestions;

                            if (suggestions.length > 0) {
                                // Inject into the suggestionList container
                                suggestionList.innerHTML = suggestions.map(item => `
                    <div class="suggestion-item" style="padding:5px; cursor:pointer; border-bottom:1px solid #eee;" data-alias="${item}">
                        ${item}
                    </div>
                `).join('');

                                suggestionBox.style.display = 'block';

                                // Suggestion click
                                suggestionList.querySelectorAll('.suggestion-item').forEach(div => {
                                    div.addEventListener('click', () => {
                                        aliasInput.value = div.dataset.alias;
                                        suggestionBox.style.display = 'none';
                                    });
                                });
                            } else {
                                suggestionBox.style.display = 'none';
                            }

                        }, 500);
                    });

                    suggestionBoxXbtn.addEventListener('click', function () {
                        suggestionBox.style.display = 'none';
                    });

                });

            </script>


