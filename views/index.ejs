                // ✅ Save UDF
                function saveUDF() {
                    const UDFID = document.getElementById('UDFHidden').value;
                    const UDFField = document.getElementById('UDFField').value;
                    const UDFModule = document.getElementById('UDFModule').value;
                    const UDFType = document.getElementById('UDFType').value;
                    const UDFLength = document.getElementById('UDFLength').value;
                    const UDForder = document.getElementById('UDForder').value;

                    const UDFDecimalCB = document.getElementById('UDFDecimalCB').checked;
                    const UDFItemwiseCB = document.getElementById('UDFItemwiseCB').checked;
                    const UDFShowTotalCB = document.getElementById('UDFShowTotalCB').checked;
                    const UDFMandatoryCB = document.getElementById('UDFMandatoryCB').checked;
                    const UDFActiveCB = document.getElementById('UDFActiveCB').checked;

                    const UDFremark = document.getElementById('UDFremark').value;

                    if (!UDFField || !UDFModule) {
                        showCustomAlert("Fill up the required fields.");
                        return;
                    }

                    if (UDFLength.length > 3) {
                        showCustomAlert("Character Length cannot exceed max length [3].");
                        return;
                    }

                    if (UDForder.length > 2) {
                        showCustomAlert("Order max length is [2].");
                        return;
                    }

                    let data = {
                        UDFID,
                        UDFField,
                        UDFModule,
                        UDFType,
                        UDFLength,
                        UDForder,
                        UDFDecimalCB,
                        UDFItemwiseCB,
                        UDFShowTotalCB,
                        UDFMandatoryCB,
                        UDFActiveCB,
                        UDFremark
                    };

                    const url = mode11 === 'edit11'
                        ? '/edit-userDefineField'
                        : '/insert-userDefineField';

                    document.getElementById('UDFsavebtn').disabled = true;

                    fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    })
                        .then(res => res.json())
                        .then(data => {
                            document.getElementById('UDFsavebtn').disabled = false;
                            showCustomAlert(data.message);
                            resetUDFForm();
                        })
                        .catch(err => {
                            document.getElementById('UDFsavebtn').disabled = false;
                            console.error(err);
                            showCustomAlert("An error occurred while saving.");
                        });
                }



                // MODE SWITCH
                function setMode11(newMode) {
                    mode11 = newMode;
                    if (mode11 === 'new11') setNewMode11();
                    if (mode11 === 'edit11') setEditMode11();
                }


                // NEW MODE
                function setNewMode11() {

                    resetUDFForm();

                    const ids = [
