            <script>
                function searchAndSortTable1() {
                    let input = document.getElementById("ASTDSearch").value.toLowerCase();
                    let table = document.getElementById("ledgerSecondMasterTable");
                    let rows = Array.from(table.getElementsByTagName("tr")).slice(1); // All rows except header


                    let sortedRows = rows.sort((a, b) => {
                        let matchA = 0;
                        let matchB = 0;

                        // Check each cell of the row and see if it matches the search term
                        let cellsA = a.getElementsByTagName("td");
                        let cellsB = b.getElementsByTagName("td");

                        // Loop through each cell and see if it matches
                        for (let i = 0; i < cellsA.length; i++) {
                            let cellA = cellsA[i].textContent || cellsA[i].innerText;
                            let cellB = cellsB[i].textContent || cellsB[i].innerText;

                            if (cellA.toLowerCase().includes(input)) matchA++;
                            if (cellB.toLowerCase().includes(input)) matchB++;

                            // ✅ Only apply highlight to non-checkbox columns
                            if (i !== 0) {
                                cellsA[i].innerHTML = highlightText1(cellA, input);
                                cellsB[i].innerHTML = highlightText1(cellB, input);
                            }

                        }

                        // Sort rows based on the number of matches
                        return matchB - matchA;  // Higher match count comes first
                    });

                    // Append the sorted rows to the table
                    sortedRows.forEach(row => table.appendChild(row));
                }

                function highlightText1(text, search) {
                    const regex = new RegExp(`(${search})`, 'gi'); // Regular expression to find matching text (case insensitive)
                    return text.replace(regex, '<span class="highlight">$1</span>'); // Wrap matched text with <span>
                }
            </script>
