            <script>
                let isRowSelected = false;

                // Function to disable all links and search input when "Close Organization" is clicked
                function closeOrganization() {
                    const links = document.querySelectorAll('.navbar-menu a');
                    const searchInput = document.querySelector('.navbar-search input');

                    // Disable all navbar links except "Organization" and "Load Organization"
                    links.forEach(link => {
                        if (!link.href.includes('#organization') && !link.href.includes('#load-organization')) {
                            link.style.pointerEvents = 'none'; // Makes the link unclickable
                            link.style.opacity = '0.5'; // Optional: visually indicate it's disabled
                        }
                    });

                    // Disable the search input
                    searchInput.disabled = true;

                    // Hide the organization table
                    document.getElementById('organization-table').style.display = 'none';

                    // Reset row selection status
                    isRowSelected = false;
                }

                // Function to display the table when "Load Organization" is clicked
                function loadOrganization() {
                    document.getElementById('organization-table').style.display = 'block';
                    isRowSelected = false; // Ensure row selection is reset
                    enableAllLinks(); // Enable all links after "Load Organization" is clicked
                }

                // Function to handle row selection in the table
                function selectRow(row) {
                    // Remove any previous selection
                    const rows = document.querySelectorAll('#organization-table tbody tr');
                    rows.forEach(r => r.style.backgroundColor = ''); // Clear background color

                    // Mark the current row as selected
                    row.style.backgroundColor = '#d3d3d3'; // Highlight selected row
                    isRowSelected = true;

                    // Enable all navbar links after row selection
                    enableAllLinks();
                }

                // Function to enable all links and search input
                function enableAllLinks() {
                    const links = document.querySelectorAll('.navbar-menu a');
                    const searchInput = document.querySelector('.navbar-search');

                    // Enable all navbar links
                    links.forEach(link => {
                        link.style.pointerEvents = 'auto'; // Enables the link
                        link.style.opacity = '1'; // Restores full opacity
                    });

                    // Enable the search input
                    searchInput.disabled = false;
                }

            </script>

