            <script>
                let allParentGroups = [];  // Store both ParentGroupName and ParentGroupAlias fetched from the server
                let filteredParentGroups = [];  // Store filtered ParentGroupNames and ParentGroupAliases based on user input

                // Function to fetch ParentGroupNames and ParentGroupAliases from the server and display them as suggestions
                function fetchParentGroups(isInitialFocus) {
                    const parentGroupsList = document.getElementById('parentGroupsList');
                    parentGroupsList.innerHTML = '';  // Clear any existing suggestions
                    parentGroupsList.style.display = 'none';  // Hide suggestions list initially

                    if (allParentGroups.length === 0 || isInitialFocus) {
                        // Fetch ParentGroupNames and ParentGroupAliases from the backend if not already fetched
                        fetch('/fetchParentGroups')
                            .then(response => response.json())
                            .then(data => {
                                if (data.parentGroups && data.parentGroups.length > 0) {
                                    allParentGroups = data.parentGroups;  // Store fetched ParentGroupNames and ParentGroupAliases
                                    filteredParentGroups = [...allParentGroups];  // Initially show all ParentGroupNames
                                    displayParentGroups(filteredParentGroups);  // Display the full list on initial focus
                                } else {
                                    const noResult = document.createElement('div');
                                    noResult.textContent = 'No Parent Groups found';
                                    noResult.style.color = 'gray';
                                    parentGroupsList.appendChild(noResult);
                                }
                            })
                            .catch(error => {
                                console.error('Error fetching Parent Groups:', error);
                                const errorMessage = document.createElement('div');
                                errorMessage.textContent = 'Error fetching Parent Groups';
                                errorMessage.style.color = 'red';
                                parentGroupsList.appendChild(errorMessage);
                            });
                    } else {
                        displayParentGroups(filteredParentGroups);  // Display the filtered list
                    }
                }

                // Function to filter ParentGroupNames and ParentGroupAliases based on user input
                function filterParentGroups() {
                    const input = document.getElementById('ledger-under').value.toLowerCase();
                    if (input === '') {
                        filteredParentGroups = [...allParentGroups];  // Show the full list when input is empty
                    } else {
                        filteredParentGroups = allParentGroups.filter(item =>
                            item.GrpName.toLowerCase().includes(input) || item.GrpAlias.toLowerCase().includes(input)
                        );
                    }
                    displayParentGroups(filteredParentGroups);
                }

                // Function to display ParentGroupNames and ParentGroupAliases in the suggestion list
                function displayParentGroups(names) {
                    const parentGroupsList = document.getElementById('parentGroupsList');
                    parentGroupsList.innerHTML = '';  // Clear previous suggestions

                    // Create an "X" button to close the list
                    const closeButton = document.createElement('button');
                    closeButton.textContent = 'X';
                    closeButton.className = 'close-button'; // Add a class for styling
                    closeButton.onclick = function (event) {
                        event.preventDefault();  // Prevent default action like form submission
                        parentGroupsList.style.display = 'none';  // Hide the parent groups list
                    };

                    parentGroupsList.appendChild(closeButton);  // Add the close button to the list

                    if (names.length > 0) {
                        // Sort the list alphabetically by GrpName
                        names.sort((a, b) => a.GrpName.localeCompare(b.GrpName));

                        parentGroupsList.style.display = 'block';  // Show the suggestions list
                        names.forEach(item => {
                            const div = document.createElement('div');
                            div.className = 'suggestion-item';

                            // Display GrpName and GrpAlias
                            div.textContent = `${item.GrpName} - ${item.GrpAlias}`;  // Show both values
                            div.onclick = function () {
                                document.getElementById('ledger-under').value = item.GrpName;  // Set the input value to GrpName
                                parentGroupsList.style.display = 'none';  // Hide the suggestions list
                            };
                            parentGroupsList.appendChild(div);
                        });
                    } else {
                        // If no matches, show a "No results" message
                        const noResult = document.createElement('div');
                        noResult.textContent = 'No matching Parent Groups found';
                        noResult.style.color = 'gray';
                        parentGroupsList.appendChild(noResult);
                    }
                }
            </script>
