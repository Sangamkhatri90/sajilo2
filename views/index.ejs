            <script>
                const shortcutInput = document.getElementById('SBMShortcutkey');

                // Arrow keys mapped to ASCII characters
                const arrowKeyToChar = {
                    'arrowup': '&',     // ASCII 38
                    'arrowdown': '(',   // ASCII 40
                    'arrowleft': '%',   // ASCII 37
                    'arrowright': '\'', // ASCII 39
                };

                let parsedShortcut = {
                    controlKey: 0,
                    shortcutKey: null,
                    displayText: ''
                };

                shortcutInput.addEventListener('keydown', function (e) {
                    e.preventDefault(); // prevent default typing

                    // Reset parsed values before processing new input
                    parsedShortcut = {
                        controlKey: 0,
                        shortcutKey: null,
                        displayText: ''
                    };

                    // Check modifier keys
                    let modifiers = [];
                    if (e.ctrlKey) modifiers.push('ctrl');
                    if (e.altKey) modifiers.push('alt');
                    if (e.shiftKey) modifiers.push('shift');

                    // If no modifiers are pressed, do nothing
                    if (modifiers.length === 0) {
                        shortcutInput.value = '';  // clear the field if no modifiers
                        return;
                    }

                    // Key to be displayed (e.g., arrow keys or single character key)
                    const key = e.key.toLowerCase();

                    let asciiChar = '';

                    // Check for special arrow keys
                    if (arrowKeyToChar[key]) {
                        asciiChar = arrowKeyToChar[key];  // Map arrow keys to their ASCII characters
                    }
                    // Check for single character keys (e.g., letters, numbers)
                    else if (key.length === 1) {
                        asciiChar = key.toUpperCase();  // Only allow letters and numbers, display uppercase
                    }

                    // If a valid key is pressed (not control, shift, alt), set it up
                    if (asciiChar) {
                        parsedShortcut = {
                            controlKey: e.ctrlKey ? 2 : 0 + e.altKey ? 1 : 0 + e.shiftKey ? 4 : 0,
                            shortcutKey: asciiChar.charCodeAt(0),
                            displayText: modifiers.concat(asciiChar).join('+')
                        };

                        // Update input value with the formatted key combo
                        shortcutInput.value = parsedShortcut.displayText;
                    }
                });

                // Optional: reset when focus is clicked
                shortcutInput.addEventListener('focus', () => {
                    ; shortcutInput.value = '';
                });
            </script>
