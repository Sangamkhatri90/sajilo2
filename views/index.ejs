            <script>
                document.getElementById('myForm165').addEventListener('submit', function (event) {
                    event.preventDefault(); // Prevent the form from submitting in the usual way

                    const EditPeanltyAcc = document.getElementById("EditAccTypePenaltySetAT").value;
                    const EditPeanltyRemarks = document.getElementById("EditAccTypePenaltyRemarks").value;
                    const selectedpenaltytoEdit = document.getElementById("EditAccTypePenaltySelectedAT").value;
                    const username = document.getElementById("EditAccTypePenaltyuser").value;
                    console.log('Selected penalty:', selectedpenaltytoEdit);

                    // Find the rows in the table
                    const rows = document.querySelectorAll("#AccTypePenalty-Edit tbody tr");
                    const EditAcctypepenaltyeffdate = document.getElementById("EditAccTypePenaltySetEffDate").value;

                    // Handle date formatting without timezone shift
                    let formattedDate = '';
                    if (EditAcctypepenaltyeffdate) {
                        // If the date is already in 'YYYY-MM-DD' format, use it directly
                        if (EditAcctypepenaltyeffdate.includes('-')) {
                            formattedDate = EditAcctypepenaltyeffdate;
                        } else {
                            // If it's in 'MM/DD/YYYY' format, convert it manually
                            const dateParts = EditAcctypepenaltyeffdate.split('/'); // Split by the slashes
                            formattedDate = `${dateParts[2]}-${String(dateParts[0]).padStart(2, '0')}-${String(dateParts[1]).padStart(2, '0')}`; // Convert to 'YYYY-MM-DD'
                        }
                    }

                    console.log('Formatted Date:', formattedDate); // Log the formatted date to ensure it's correct

                    // Create an array to hold the updated checkbox values
                    const updatedCheckboxData = [];

                    rows.forEach((row, index) => {
                        const checkbox = row.querySelector('input[type="checkbox"]'); // Find the checkbox
                        const isChecked = checkbox ? checkbox.checked : false; // Get the checkbox state (true/false)

                        // If the checkbox state has changed, we prepare the data for the update
                        if (isChecked !== undefined) {
                            updatedCheckboxData.push({
                                index: index, // Index to identify which row is being updated
                                serialNo: index + 1,  // Serial number (S.No) of the row
                                perDayChecked: isChecked // The new state of the checkbox (true/false)
                            });
                        }
                    });

                    // Send both requests together using Promise.all
                    const penaltyUpdateRequest = fetch('/updateAccTypePenaltyMas', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            EditPeanltyAcc: EditPeanltyAcc,
                            selectedpenaltytoEdit: selectedpenaltytoEdit,
                            EditPeanltyRemarks: EditPeanltyRemarks,
                            username: username,
                            formattedDate: formattedDate
                        })
                    });

                    const checkboxUpdateRequest = fetch('/updateCheckboxData', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            updatedData: updatedCheckboxData,
                            selectedpenaltytoEdit: selectedpenaltytoEdit,
                            formattedDate: formattedDate
                        })
                    });

                    // Use Promise.all to execute both fetch requests together
                    Promise.all([penaltyUpdateRequest, checkboxUpdateRequest])
                        .then(responses => {
                            // Check if both requests are successful
                            return Promise.all(responses.map(response => response.json()));
                        })
                        .then(data => {
                            // All requests were successful
                            console.log('All data updated successfully:', data);
                            showCustomAlert('Penalty Master updated successfully!');
                            document.getElementById("myForm165").reset(); // Reset the form after success

                        })
                        .catch(error => {
                            // At least one request failed
                            console.error('Error updating data:', error);
                            showCustomAlert('An error occurred while updating the data.');
                        });
                });
            </script>
