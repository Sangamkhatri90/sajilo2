                                });

                                // Add final total row
                                const formattedTotalAmount = totalAmount < 0
                                    ? `(${Math.abs(totalAmount).toFixed(2)})`
                                    : totalAmount.toFixed(2);

                                htmlRows += `
            <tr style="font-weight:bold;">
                <td colspan="3">Total</td>
                <td>${formattedTotalAmount}</td>
            </tr>
        `;

                                // Populate and show
                                grpsummaryTbody.innerHTML = htmlRows;
                                frGsMainDt.style.display = 'block';

                            } catch (err) {
                                console.error('Error fetching Include Opening amounts:', err);
                            }
                        }

                        else if (subledger.checked) {
                            GrpSummaryLedgerMDiv.style.display = 'none';

                            // Collect selected ledgers
                            const selectedLedgers = [...document.querySelectorAll('.ledger-sub-group-summary-checkbox:checked')];
                            if (selectedLedgers.length === 0) {
                                console.warn('No ledger items selected. Not showing summary table.');
                                return;
                            }

                            const ledgerData = selectedLedgers.map(cb => {
                                const row = cb.closest('tr');
                                return {
                                    name: row?.cells[2]?.textContent?.trim() || '',
                                    alias: row?.cells[3]?.textContent?.trim() || ''
                                };
                            });
                            const ledgerNames = ledgerData.map(item => item.name);

                            const formattedFrom = fromDate.replaceAll('-', '/');
                            const formattedTo = toDate.replaceAll('-', '/');

                            try {
                                const resp = await fetch('/api/gs/SLtablepop', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify({
                                        ledgerNames,
                                        fromDate: formattedFrom,
                                        toDate: formattedTo
                                    })
                                });

                                if (!resp.ok) throw new Error(`Server responded with ${resp.status}`);
                                const resultData = await resp.json();

                                let grandTotal = 0;
                                let numberingMain = 1;
                                let rowsHtml = '';

                                for (const group of resultData) {
                                    // Group Header Row
                                    rowsHtml += `
          <tr>
            <td>${numberingMain}</td>
            <td>${group.grpName}</td>
            <td>${group.grpAlias}</td>
            <td></td>
          </tr>
        `;

