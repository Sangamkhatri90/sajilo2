            <script>
                document.getElementById('myForm82').addEventListener('submit', function (event) {
                    event.preventDefault();  // Prevent the form from submitting the default way

                    // Collect the data from the form fields
                    const formData = new FormData(this);  // Automatically collects all form field values

                    // Convert FormData to a plain object
                    const data = Object.fromEntries(formData.entries());

                    // Send the data to the backend via a POST request using fetch
                    fetch('/copy-doc-class', {
                        method: 'POST',
                        body: JSON.stringify(data),  // Convert form data to JSON
                        headers: {
                            'Content-Type': 'application/json',  // Specify the content type as JSON
                        }
                    })
                        .then(response => response.json())
                        .then(result => {
                            // Handle the response from the backend
                            if (result.success) {
                                showCustomAlert(result.message);  // Show success message
                                // Clear the form inputs after successful submission
                                document.getElementById('myForm82').reset();  // Resets the form inputs
                                // Optionally, hide the edit form
                                document.getElementById('movableDiv82').style.display = 'none';
                            } else {
                                showCustomAlert('Error: ' + result.message);  // Show error message
