                <script>
                    // Function to show the popup with the table
                    document.getElementById("myForm118").addEventListener("submit", function (event) {
                        event.preventDefault(); // Prevent form submission
                        const brsresult = document.getElementById("DE_BRS_popupTableDiv"); // retrieving the value

                        let highestZIndex = 3;

                        function bringToFront(element) {
                            highestZIndex++;
                            element.style.zIndex = highestZIndex;
                        }

                        function makeDivMovable(div) {
                            let isDragging = false;
                            let offsetX, offsetY;

                            div.addEventListener('mousedown', (e) => {
                                if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
                                    return; // Allow interaction with input fields
                                }
                                e.preventDefault();
                                bringToFront(div);

                                const rect = div.getBoundingClientRect();
                                offsetX = e.clientX - rect.left;
                                offsetY = e.clientY - rect.top;

                                isDragging = true;
                            });

                            document.addEventListener('mousemove', (e) => {
                                if (isDragging) {
                                    div.style.left = `${e.pageX - offsetX}px`;
                                    div.style.top = `${e.pageY - offsetY}px`;
                                    div.style.position = 'absolute';
                                }
                            });

                            document.addEventListener('mouseup', () => {
                                isDragging = false;
                            });
                        }

                        makeDivMovable(brsresult);

                        // Get the value from the "Bank Book" input field
                        const bankBookValue = document.getElementById('DEbank-name-input').value;
                        const fromDate = document.getElementById("DE_datefrom_BRS").value;
                        const toDate = document.getElementById("DE_dateto_BRS").value;

                        let formattedfromDate = '';
                        if (fromDate) {
                            // Check if the input is in 'YYYY-DD-MM' format
                            if (fromDate.includes('-')) {
                                const dateParts = fromDate.split('-'); // Split by hyphens
                                formattedfromDate = `${dateParts[0]}/${dateParts[1]}/${dateParts[2]}`; // Convert to 'YYYY/MM/DD'

                            } else {
                                formattedfromDate = fromDate; // If not in expected format, return as-is or handle accordingly
                            }
                        }



                        let formattedtoDate = '';
                        if (toDate) {
                            // Check if the input is in 'YYYY-DD-MM' format
                            if (toDate.includes('-')) {
                                const dateParts = toDate.split('-'); // Split by hyphens
                                formattedtoDate = `${dateParts[0]}/${dateParts[1]}/${dateParts[2]}`; // Convert to 'YYYY/MM/DD'

                            } else {
                                formattedtoDate = toDate; // If not in expected format, return as-is or handle accordingly
                            }
                        }
                        // Fetch the totals from the backend by sending the Bank Book name
                        fetch(`/fetchTotalAmountsForDE_BRS?bankBookName=${encodeURIComponent(bankBookValue)}&fromDate=${encodeURIComponent(formattedfromDate)}&toDate=${encodeURIComponent(formattedtoDate)}`)
                            .then(response => response.json())
                            .then(data => {
                                const totalDrAmount = data.totalDrAmount || 0;
                                const totalCrAmount = data.totalCrAmount || 0;
                                const addSubRows = data.addSubRows || [];
                                const lessSubRows = data.lessSubRows || [];

                                // Calculate the Amount (CrAmount - DrAmount)
                                let amount = totalCrAmount - totalDrAmount;

                                // Check if the amount is negative or positive and update accordingly
                                let amountDisplay = '';
                                if (amount < 0) {
                                    // If the amount is negative, display positive and add "Dr"
                                    amountDisplay = `${Math.abs(amount).toFixed(2)} Dr`; // Make amount positive
                                } else {
                                    // If the amount is positive, add "Cr"
                                    amountDisplay = `${amount.toFixed(2)} Cr`;
                                }

                                // Show the popup table
                                const popupTableDiv = document.getElementById("DE_BRS_popupTableDiv");
                                popupTableDiv.style.display = "block";

                                // Clear table body
                                const tableBody = document.querySelector('#DE_BRS_popupTableDiv table tbody');
                                tableBody.innerHTML = '';

                                // Initialize serial number
                                let serialNumber = 1;

                                // Normalize and combine both credit and debit rows
                                const combinedRows = [
                                    ...addSubRows.map(sub => ({
                                        ...sub,
                                        isCredit: true,
                                        received: sub.amount,
                                        payment: ''
                                    })),
                                    ...lessSubRows.map(sub => ({
                                        ...sub,
                                        isCredit: false,
                                        received: '',
                                        payment: sub.amount
                                    }))
                                ];

                                // Optional: Sort by JV_Miti or ChequeDate if needed
                                // combinedRows.sort((a, b) => new Date(a.jv_miti) - new Date(b.jv_miti)); // optional

                                // Populate the table row by row
                                combinedRows.forEach(sub => {
                                    const row = document.createElement('tr');
                                    row.innerHTML = `
        <td>${serialNumber++}</td>
        <td>${sub.jv_miti || ''}</td>
        <td>${sub.voucherno || ''}</td>
        <td>${sub.chequeno || ''}</td>
        <td>${sub.chequedate || ''}</td>
        <td></td>
        <td>${sub.type || ''}</td>
        <td>${sub.received}</td>
        <td>${sub.payment}</td>
        <td>${sub.glalias || ''}</td>
    `;
                                    tableBody.appendChild(row);
                                });





                                // Function to close the popup table when "OK" is clicked
                                document.getElementById("DE_brs-tb-okbutton").addEventListener("click", function () {
                                    popupTableDiv.style.display = "none";
                                });

                                // Function to print the table content when "Print" is clicked
                                document.getElementById("DE_brs-tb-printbutton").addEventListener("click", function () {
                                    const printWindow = window.open('', '', 'height=600,width=800');
                                    printWindow.document.write('<html><head><title>Table Print</title></head><body>');
                                    printWindow.document.write(document.querySelector('.table-container').outerHTML);
                                    printWindow.document.write('</body></html>');
                                    printWindow.document.close();
                                    printWindow.print();
                                });

                                // Function to export the table to CSV when "Export" is clicked
                                document.getElementById("DE_brs-tb-exportbutton").addEventListener("click", function () {
                                    const rows = document.querySelectorAll("table tr");
                                    const csvData = [];

                                    rows.forEach(row => {
                                        const rowData = [];
                                        row.querySelectorAll("td, th").forEach(cell => {
                                            rowData.push(cell.innerText);
                                        });
                                        csvData.push(rowData.join(","));
                                    });

                                    // Create a CSV string
                                    const csvString = csvData.join("\n");

                                    // Create a Blob and download the CSV file
                                    const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
                                    const link = document.createElement('a');
                                    link.href = URL.createObjectURL(blob);
                                    link.download = 'table_data.csv';
                                    link.click();
                                });

                                // Function to close the popup table when the close button is clicked
                                document.getElementById("DE_BRS_closeTableButton").addEventListener("click", function () {
                                    popupTableDiv.style.display = "none";
                                });
                            })
                            .catch(error => {
                                console.error('Error fetching data:', error);
                            });
                    });

                </script>
