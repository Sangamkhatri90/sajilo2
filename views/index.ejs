                                    rowsHtml += `
          <tr>
            <td>${numberingSub}</td>
            <td>${group.subGrpName}</td>
            <td>${group.subGrpAlias}</td>
            <td></td>
          </tr>
        `;

                                    const numberingLedger = `${numberingSub}.1`;
                                    let ledgerAmount = group.amount || 0;
                                    grandTotal += ledgerAmount;
                                    let formattedLedgerAmount = ledgerAmount < 0
                                        ? `(${Math.abs(ledgerAmount).toFixed(2)})`
                                        : ledgerAmount.toFixed(2);

                                    rowsHtml += `
          <tr>
            <td>${numberingLedger}</td>
            <td>${group.ledgerName}</td>
            <td>${group.ledgerAlias}</td>
            <td>${formattedLedgerAmount}</td>
          </tr>
        `;

                                    if (group.subLedgers && group.subLedgers.length > 0) {
                                        let numberingSubLedgerCounter = 1;
                                        for (const sub of group.subLedgers) {
                                            let subAmount = sub.amount || 0;
                                            grandTotal += subAmount;
                                            let formattedSubAmount = subAmount < 0
                                                ? `(${Math.abs(subAmount).toFixed(2)})`
                                                : subAmount.toFixed(2);

                                            const numberingSubLedger = `${numberingLedger}.${numberingSubLedgerCounter}`;
                                            numberingSubLedgerCounter++;

                                            rowsHtml += `
              <tr>
                <td>${numberingSubLedger}</td>
                <td>${sub.subLedgerName}</td>
                <td>${sub.subLedgerAlias}</td>
                <td>${formattedSubAmount}</td>
              </tr>
            `;
                                        }
                                    }

                                    numberingMain++;
                                }

                                // Add Grand Total row
                                const formattedGrandTotal = grandTotal < 0
                                    ? `(${Math.abs(grandTotal).toFixed(2)})`
                                    : grandTotal.toFixed(2);

                                rowsHtml += `
        <tr style="font-weight:bold;">
          <td></td>
          <td>Total</td>
          <td></td>
          <td>${formattedGrandTotal}</td>
        </tr>
      `;

                                grpsummaryTbody.innerHTML = rowsHtml;
                                frGsMainDt.style.display = 'block';

                            } catch (err) {
                                console.error('Error fetching sub-ledger summary amounts:', err);
                            }
                        }


                        else {
                            // Normal (existing) flow when Include Opening not checked
                            // Collect selected ledgers
                            const selectedLedgers = [...document.querySelectorAll('.ledger-sub-group-summary-checkbox:checked')];

                            if (selectedLedgers.length === 0) {
                                console.warn('No ledger items selected. Not showing summary table.');
                                return;
                            }

                            // Build final summary table rows
                            const rowsHtml = selectedLedgers.map((cb, i) => {
                                const row = cb.closest('tr');
                                const ledgerName = row?.cells[2]?.textContent?.trim() || '';
                                const ledgerAlias = row?.cells[3]?.textContent?.trim() || '';
                                const amount = '10.00';  // Default amount

                                return `
                <tr>
                    <td>${i + 1}</td>
                    <td>${ledgerName}</td>
                    <td>${ledgerAlias}</td>
                    <td>${amount}</td>
                </tr>
            `;
                            }).join('');

                            grpsummaryTbody.innerHTML = rowsHtml;
                            frGsMainDt.style.display = 'block';
                        }
                    });



                });
            </script>





