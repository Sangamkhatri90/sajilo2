            <script>
                document.getElementById('myForm166').addEventListener('submit', function (event) {
                    event.preventDefault(); // Prevent the form from submitting in the usual way

                    const CopyPeanltyAcc = document.getElementById("CopyAccTypePenaltySetAT").value;
                    const CopyPeanltyRemarks = document.getElementById("CopyAccTypePenaltyRemarks").value;
                    const selectedpenaltytoCopy = document.getElementById("CopyAccTypePenaltySelectedAT").value;
                    const username = document.getElementById("CopyAccTypePenaltyuser").value;
                    console.log('Selected penalty:', selectedpenaltytoCopy);

                    // Find the rows in the table
                    const rows = document.querySelectorAll("#AccTypePenalty-Copy tbody tr");
                    const CopyAcctypepenaltyeffdate = document.getElementById("CopyAccTypePenaltySetEffDate").value;

                    // Handle date formatting without timezone shift
                    let formattedDate = '';
                    if (CopyAcctypepenaltyeffdate) {
                        // If the date is already in 'YYYY-MM-DD' format, use it directly
                        if (CopyAcctypepenaltyeffdate.includes('-')) {
                            formattedDate = CopyAcctypepenaltyeffdate;
                        } else {
                            // If it's in 'MM/DD/YYYY' format, convert it manually
                            const dateParts = CopyAcctypepenaltyeffdate.split('/'); // Split by the slashes
                            formattedDate = `${dateParts[2]}-${String(dateParts[0]).padStart(2, '0')}-${String(dateParts[1]).padStart(2, '0')}`; // Convert to 'YYYY-MM-DD'
                        }
                    }

                    console.log('Formatted Date:', formattedDate); // Log the formatted date to ensure it's correct

                    // Create an array to hold the updated checkbox values and table data
                    const updatedCheckboxData = [];
                    const tableData = [];

                    rows.forEach((row, index) => {
                        const checkbox = row.querySelector('input[type="checkbox"]'); // Find the checkbox
                        const isChecked = checkbox ? checkbox.checked : false; // Get the checkbox state (true/false)

                        // Extract data from the columns
                        const fromDay = parseInt(row.cells[1] ? row.cells[1].innerText : "NaN", 10); // cell 1: fromDay (index 0)
                        const toDay = parseInt(row.cells[2] ? row.cells[2].innerText : "NaN", 10);   // cell 2: toDay (index 1)

                        // Only add rows where fromDay and toDay have valid values
                        if (!isNaN(fromDay) && !isNaN(toDay) && fromDay > 0 && toDay > 0) {
                            const percentageOnP = parseFloat(row.cells[3] ? row.cells[3].innerText.replace('%', '') : ""); // cell 3: percentageOnP (index 2)
                            const percentageOnI = parseFloat(row.cells[4] ? row.cells[4].innerText.replace('%', '') : ""); // cell 4: percentageOnI (index 3)

                            // PerDay value (if checked, send 1, otherwise send 0)
                            const perDay = isChecked ? 1 : 0;

                            // Add this row data to the tableData array
                            const rowData = {
                                serialNo: index + 1,
                                checkboxChecked: isChecked,
                                col1Data: fromDay, // This is an INT, ensure it's a valid integer
                                col2Data: toDay,   // This is an INT, ensure it's a valid integer
                                col3Data: percentageOnP, // This is NUMERIC, ensure it's a valid decimal number
                                col4Data: percentageOnI, // This is MONEY, ensure it's a valid decimal number
                            };

                            tableData.push(rowData); // Add row data to the tableData array

                            // If the checkbox is checked, add it to the updatedCheckboxData array
                            if (isChecked !== undefined) {
                                updatedCheckboxData.push({
                                    index: index,
                                    serialNo: index + 1,
                                    perDayChecked: isChecked
                                });
                            }
                        } else {
                            console.log(`Row ${index + 1} skipped due to invalid fromDay or toDay values.`);
                        }
                    });

                    console.log('Filtered Table Data being sent:', tableData);
                    console.log('Updated Checkbox Data being sent:', updatedCheckboxData);

                    // Send the first request to copy the penalty data
                    fetch('/CopyAccTypePenaltyMas', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            CopyPeanltyAcc: CopyPeanltyAcc,
                            selectedpenaltytoCopy: selectedpenaltytoCopy,
                            CopyPeanltyRemarks: CopyPeanltyRemarks,
                            username: username,
                            formattedDate: formattedDate
                        })
                    })
                        .then(response => response.json()) // Wait for the first response
                        .then(data => {
                            if (data.success) {
                                console.log('MethodID from first backend:', data.penmethodID); // Ensure this is not undefined
                                const penmethodID = data.penmethodID;  // Get MethodID from the first request's response

                                // Send the second request to copy the table data with the obtained penmethodID
                                return fetch('/copyTablepenaltyData', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify({
                                        penmethodID: penmethodID,  // Send the MethodID from the first response
                                        tableData: tableData,      // Send the table data to the backend
                                        updatedCheckboxData: updatedCheckboxData // Send the updated checkbox data to the backend
                                    })
                                });
                            } else {
                                throw new Error('Failed to copy penalty data');
                            }
                        })
                        .then(response => response.json()) // Wait for the second response
                        .then(data => {
                            // All requests were successful
                            console.log('All data copied successfully:', data);
                            showCustomAlert('Penalty Master copied successfully!');
                            document.getElementById("myForm166").reset(); // Reset the form after success
                        })
                        .catch(error => {
                            // At least one request failed
                            console.error('Error copying data:', error);
                            showCustomAlert('An error occurred while copying the data.');
                        });
                });
            </script>
