            <script>
                document.addEventListener("DOMContentLoaded", () => {
                    const transferBtn = document.getElementById("STST-TransBtn");
                    const table = document.getElementById("savetosharetranstable");
                    const dateInput = document.getElementById("STST-transdate");
                    const startVal = document.getElementById("startDateInput").textContent.trim();
                    const endVal = document.getElementById("endDateInput").textContent.trim();

                    const startYear = startVal.split("-")[0]; // "2079"
                    const endYear = endVal.split("-")[0];   // "2080"

                    const fyCode = startYear.slice(-2) + endYear.slice(-2); // "7980"

                    transferBtn.addEventListener("click", async () => {
                        const transDateRaw = dateInput.value.trim();
                        if (!transDateRaw) {
                            alert("Please select a transaction date before transferring!");
                            return;
                        }

                        // Convert YYYY-MM-DD → DD/MM/YYYY
                        const [year, month, day] = transDateRaw.split("-");
                        const transDate = `${day}/${month}/${year}`;

                        // Check if table has meaningful data
                        const tableRows = table.querySelectorAll("tbody tr");
                        let hasData = false;
                        const rows = [];

                        tableRows.forEach(tr => {
                            const acName = tr.querySelector(".ac-name")?.textContent.trim();
                            const acBalance = parseFloat(tr.querySelector(".ac-balance")?.textContent) || 0;
                            const transferAmount = parseFloat(tr.querySelector(".transfer-amount")?.textContent) || 0;

                            if (acName && transferAmount > 0) hasData = true;

                            rows.push({
                                AcName: acName || "",
                                GLID: tr.dataset.glid,
                                SLID: tr.dataset.slid,
                                shareSLID: tr.dataset.shareSlid,
                                AcBalance: acBalance,
                                TransferAmount: transferAmount
                            });
                        });

                        if (!hasData) {
                            alert("Table is empty! Populate data first, you can do so by clicking Go.");
                            return;
                        }

                        try {
                            transferBtn.disabled = true;
                            transferBtn.textContent = "Processing...";

                            const res = await fetch("/api/savingToShareTransferProcess", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ transDate, rows, fyCode })
                            });

                            const data = await res.json();
                            if (!res.ok) {
                                alert(`❌ Transfer failed: ${data.error || "Unknown error"}`);
                                return;
                            }

                            const { success = [], failed = [] } = data.summary;

                            // Build modal content
                            let textContent = "=== Saving → Share Transfer Summary ===\n\n";

                            textContent += "✔ SUCCESSFUL ACCOUNTS:\n";
                            if (success.length === 0) textContent += "None\n";
                            success.forEach((item, i) => {
                                textContent += `${i + 1}. ${item.AcName.padEnd(30)} ${item.VoucherNo.padEnd(20)} ${item.MemberAlias}\n`;
                            });

                            textContent += "\n❌ FAILED ACCOUNTS:\n";
                            if (failed.length === 0) textContent += "None\n";
                            failed.forEach((item, i) => {
                                textContent += `${i + 1}. ${item.AcName.padEnd(30)} ${item.reason.padEnd(20)} ${item.MemberAlias || "N/A"}\n`;
                            });

                            // Create modal dynamically
                            const modal = document.createElement("div");
                            modal.style.position = "fixed";
                            modal.style.top = "0";
