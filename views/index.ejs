            <script>
                let allMenuForSTC = [];  // Store both MenuName and Alias fetched from the server
                let filteredMenuForSTC = [];  // Store filtered MenuNames and Aliases based on user input

                // Function to fetch MenuNames and Aliases from the server and display them as suggestions
                function fetchMenuNamesForSTC(isInitialFocus) {
                    const menuList = document.getElementById('menuListForSTC');
                    menuList.innerHTML = '';  // Clear any existing suggestions
                    menuList.style.display = 'none';  // Hide suggestions list initially

                    if (allMenuForSTC.length === 0 || isInitialFocus) {
                        // Fetch MenuNames and Aliases from the backend if not already fetched
                        fetch('/fetchMenuNameForSTC')
                            .then(response => response.json())
                            .then(data => {
                                if (data.menuItems && data.menuItems.length > 0) {
                                    allMenuForSTC = data.menuItems;  // Store fetched MenuNames and Aliases
                                    filteredMenuForSTC = [...allMenuForSTC];  // Initially show all MenuNames
                                    displayMenuNamesForSTC(filteredMenuForSTC);  // Display the full list on initial focus
                                } else {
                                    const noResult = document.createElement('div');
                                    noResult.textContent = 'No MenuNames found';
                                    menuList.appendChild(noResult);
                                }
                            })
                            .catch(error => {
                                console.error('Error fetching MenuNames:', error);
                                const errorMessage = document.createElement('div');
                                errorMessage.textContent = 'Error fetching MenuNames';
                                menuList.appendChild(errorMessage);
                            });
                    } else {
                        displayMenuNamesForSTC(filteredMenuForSTC);  // Display the filtered list
                    }
                }

                // Function to filter MenuNames and Aliases based on user input
                function filterMenuNamesForSTC() {
                    const input = document.getElementById('menu-name-STC').value.toLowerCase();
                    if (input === '') {
                        filteredMenuForSTC = [...allMenuForSTC];  // Show the full list when input is empty
                    } else {
                        filteredMenuForSTC = allMenuForSTC.filter(item =>
                            item.MenuName.toLowerCase().includes(input) || item.Alias.toLowerCase().includes(input)
                        );
                    }
                    displayMenuNamesForSTC(filteredMenuForSTC);
                }

                // Function to display MenuNames and Aliases in the suggestion list with alphabetical sorting
                function displayMenuNamesForSTC(names) {
                    const menuList = document.getElementById('menuListForSTC');
                    menuList.innerHTML = '';  // Clear previous suggestions

                    // Sort the list alphabetically by MenuName (case insensitive)
                    names.sort((a, b) => a.MenuName.toLowerCase().localeCompare(b.MenuName.toLowerCase()));

                    // Create and append the close button
                    const closeButton = document.createElement('button');
                    closeButton.textContent = 'X';
                    closeButton.onclick = function (event) {
                        event.preventDefault();
                        menuList.style.display = 'none';  // Hide the suggestions list when the close button is clicked
                    };
                    menuList.appendChild(closeButton);  // Append the close button to the list

                    if (names.length > 0) {
                        menuList.style.display = 'block';  // Show the suggestions list
                        names.forEach(item => {
                            const div = document.createElement('div');
                            div.textContent = `${item.MenuName} - ${item.Alias}`;  // Show both MenuName and Alias
                            div.onclick = function () {
                                document.getElementById('menu-name-STC').value = item.MenuName;  // Set the input value to MenuName
                                menuList.style.display = 'none';  // Hide the suggestions list
                            };
                            menuList.appendChild(div);
                        });
                    } else {
                        const noResult = document.createElement('div');
                        noResult.textContent = 'No matching MenuNames found';
                        menuList.appendChild(noResult);
                    }
                }
