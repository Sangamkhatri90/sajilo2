            <script>
                document.getElementById('myForm176').addEventListener('submit', async function (event) {
                    event.preventDefault();

                    const transactionNo = document.getElementById("CopyShareTrans-transno").value;

                    if (!transactionNo) {
                        showCustomAlert("Please enter a Transaction Number.");
                        return;
                    }

                    try {
                        // Step 1: Check for duplicate transaction number
                        const checkResponse = await fetch("/copyShareTransMasCheckingField", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({ transactionNo })
                        });

                        const checkData = await checkResponse.json();

                        if (checkData.duplicate) {
                            showCustomAlert("❌ Duplicate data is not allowed. Please check the Transaction no.");
                            return;
                        }

                        // Step 2: Prepare form data
                        const CopyShareTransMasNumber = transactionNo;
                        const CopyShareTransMasSelectedNumber = document.getElementById("CopyShareTransSelected-transno").value;
                        const CopyShareTransMasAccNumber = document.getElementById("CopyShareTrans-accID").value;
                        const CopyShareTransMasTransftoAccnumber = document.getElementById("CopyShareTrans-Transferto").value;
                        const CopyShareTransMasTransType = document.getElementById("CopyShareTrans-option").value;
                        const CopyShareTransMasRemarks = document.getElementById("CopyShareTrans-Remarks").value;
                        const CopyShareTransMasEffDate = document.getElementById("CopyShareTrans-TransDate").value;
                        const CopyShareTransMasTotalShare = document.getElementById("CopyShareTrans-Totalshare").value;
                        const CopyShareTransMasSharestartFrom = document.getElementById("CopyShareTrans-StartFrom").value;
                        const CopyShareTransMasShareEndTo = document.getElementById("CopyShareTrans-To").value;
                        const CopyShareTransMasUsername = document.getElementById("CopyShareTransMas-username").value;

                        // Format date to YYYY-MM-DD
                        const formatDate = (dateString) => {
                            if (!dateString) return '';
                            if (dateString.includes('-')) return dateString;
                            const [mm, dd, yyyy] = dateString.split('/');
                            return `${yyyy}-${mm.padStart(2, '0')}-${dd.padStart(2, '0')}`;
                        };

                        const stformattedDate = formatDate(CopyShareTransMasEffDate);
                        console.log('Share Trans copy Formatted Date:', stformattedDate);

                        // Step 3: Extract table data
                        const rows = document.querySelectorAll("#CopyShareTransmastable2 tbody tr");
                        const tableData = Array.from(rows).map((row, index) => {
                            const share_no = parseInt(row.cells[1] ? row.cells[1].innerText : "NaN", 10);
                            return {
                                serialNo: index + 1,
                                col1Data: share_no
                            };
                        });

                        console.log('Filtered Table Data being sent:', tableData);

                        // Step 4: First POST request (master data)
                        const masterResponse = await fetch('/copyShareTransMas', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                CopyShareTransMasNumber,
                                CopyShareTransMasSelectedNumber,
                                CopyShareTransMasAccNumber,
                                CopyShareTransMasTransftoAccnumber,
                                CopyShareTransMasTransType,
                                CopyShareTransMasRemarks,
                                stformattedDate,
                                CopyShareTransMasTotalShare,
                                CopyShareTransMasSharestartFrom,
                                CopyShareTransMasShareEndTo,
                                username: CopyShareTransMasUsername
                            })
                        });

                        const masterData = await masterResponse.json();

                        if (!masterData.success || !masterData.shareTransID) {
                            throw new Error('Failed to copy share transaction master data');
                        }

                        const shareTransID = masterData.shareTransID;
                        console.log('ShareTransactionID from first backend:', shareTransID);

                        // Step 5: Second POST request (table data)
                        const tableResponse = await fetch('/copyTable2ShareTransmasData', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                shareTransID,
                                tableData
                            })
                        });

                        const tableResult = await tableResponse.json();
                        console.log('All data copied successfully:', tableResult);
                        showCustomAlert('Share Transaction Master copied successfully!');
                        document.getElementById("myForm176").reset(); // Reset the form

                    } catch (error) {
                        console.error('Error copying data:', error);
                        showCustomAlert('An error occurred while copying the data.');
                    }
                });
            </script>

