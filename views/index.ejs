                                subGroupRow.innerHTML = `
        <td style="font-weight:bold; background:#e6f0ff">&nbsp;&nbsp;&nbsp;${item.subGroup}</td>
        <td style="font-weight:bold; background:#e6f0ff">${item.subGroupAlias}</td>
