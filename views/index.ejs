                    ids.forEach(id => document.getElementById(id).disabled = false);

                    // Active should remain disabled in NEW
                    document.getElementById('UDFActiveCB').disabled = true;
                }


                // EDIT MODE
                function setEditMode11() {

                    const ids = [
                        'UDFField', 'UDFModule', 'UDFType', 'UDFLength', 'UDForder',
                        'UDFDecimalCB', 'UDFItemwiseCB', 'UDFShowTotalCB',
                        'UDFMandatoryCB', 'UDFremark'
