            <script>
                function searchAndSortTableunlitmited(inputEl) {

                    let input = inputEl.value.toLowerCase();
                    let tableId = inputEl.dataset.target;
                    let table = document.getElementById(tableId);

                    if (!table) return;

                    let rows = Array.from(table.getElementsByTagName("tr")).slice(1);

                    // Sort rows based on match count
                    let sortedRows = rows.sort((a, b) => {
                        let matchA = 0;
                        let matchB = 0;

                        let cellsA = a.getElementsByTagName("td");
                        let cellsB = b.getElementsByTagName("td");

                        for (let i = 0; i < cellsA.length; i++) {
                            let cellA = cellsA[i].innerText.toLowerCase();
                            let cellB = cellsB[i].innerText.toLowerCase();

                            if (cellA.includes(input)) matchA++;
                            if (cellB.includes(input)) matchB++;

                            // highlight (skip checkbox column)
                            if (i !== 0) {
                                cellsA[i].innerHTML = highlight(cellA, input);
                                cellsB[i].innerHTML = highlight(cellB, input);
                            }
                        }

                        return matchB - matchA;
                    });

                    // Re-append sorted rows
                    sortedRows.forEach(row => table.appendChild(row));
                }

                // Highlight function
                function highlight(text, search) {
                    if (!search) return text;
                    const regex = new RegExp(`(${search})`, "gi");
                    return text.replace(regex, `<span class="highlight">$1</span>`);
                }

                // Attach input listener to all search boxes
                document.addEventListener("input", function (e) {
                    if (e.target.classList.contains("table-search")) {
                        searchAndSortTableunlitmited(e.target);
                    }
                });
            </script>

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const mainInstallmentScheForm = document.getElementById('myForm78');
                    const InsaccounttypeCB = document.getElementById('InsaccounttypeCB');
                    const InsaccountnameCB = document.getElementById('InsaccountnameCB');
                    const installmentValuesMainDiv = document.getElementById('installmentValuesMainDiv');
                    const installmentValuesMainForm = document.getElementById('installmentValuesMainForm');
                    const closeButtons = [

                        { buttonId: 'installmentValuesMainClo', div: installmentValuesMainDiv },
                        { buttonId: 'installmentValuesMainCan', div: installmentValuesMainDiv },


                    ];

                    closeButtons.forEach(({ buttonId, div }) => {
                        document.getElementById(buttonId).addEventListener('click', function (e) {
                            e.preventDefault();
                            div.style.display = 'none';
                        });
                    });
                    let highestZIndex = 3;
                    const bringToFront = el => { highestZIndex += 1; el.style.zIndex = highestZIndex; };

                    /* === DO NOT EDIT ANYTHING INSIDE THIS FUNCTION === */
                    const makeDivMovable = div => {
                        let isDragging = false;
                        let offsetX, offsetY;

                        div.addEventListener('mousedown', e => {
                            if (['INPUT', 'TEXTAREA'].includes(e.target.tagName)) return;
                            e.preventDefault();
                            bringToFront(div);

                            const { left, top } = div.getBoundingClientRect();
                            offsetX = e.clientX - left;
                            offsetY = e.clientY - top;
                            isDragging = true;
                        });

                        document.addEventListener('mousemove', e => {
                            if (!isDragging) return;
                            div.style.position = 'absolute';
                            div.style.left = `${e.pageX - offsetX}px`;
                            div.style.top = `${e.pageY - offsetY}px`;
                        });

                        document.addEventListener('mouseup', () => { isDragging = false; });
                    };
                    [installmentValuesMainDiv].forEach(makeDivMovable);

                    mainInstallmentScheForm.addEventListener('submit', async e => {
                        e.preventDefault();

                        const installmentDateFrom = document.getElementById('installmentDateFrom').value;
