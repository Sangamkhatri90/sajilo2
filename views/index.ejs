                                bankNamesList.appendChild(errorMessage);
                            });
                    } else {
                        displayBankNamesForDEBR(filteredBankNamesForDEBR);  // Display the filtered list
                    }
                }

                // Function to filter BankNames and BankAliases based on user input
                function filterBankNamesForDEBR() {
                    const input = document.getElementById('DEbank-name-input').value.toLowerCase();
                    if (input === '') {
                        filteredBankNamesForDEBR = [...allBankNamesForDEBR];  // Show the full list when input is empty
                    } else {
                        filteredBankNamesForDEBR = allBankNamesForDEBR.filter(item =>
                            item.GLName.toLowerCase().includes(input) || item.GlAlias.toLowerCase().includes(input)
                        );
                    }
                    // Sort the filtered list alphabetically by GLName
                    filteredBankNamesForDEBR.sort((a, b) => a.GLName.localeCompare(b.GLName));
                    displayBankNamesForDEBR(filteredBankNamesForDEBR);
                }

                // Function to display BankNames and BankAliases in the suggestion list
                function displayBankNamesForDEBR(names) {
                    const bankNamesList = document.getElementById('bankNamesListofDEBR');
                    bankNamesList.innerHTML = '';  // Clear previous suggestions

                    // Create and append the close button
                    const closeButton = document.createElement('button');
                    closeButton.textContent = 'X';
                    closeButton.onclick = function (event) {
                        event.preventDefault();
                        bankNamesList.style.display = 'none';  // Hide the suggestions list when the close button is clicked
                    };
                    bankNamesList.appendChild(closeButton);  // Append the close button to the list

                    if (names.length > 0) {
                        bankNamesList.style.display = 'block';  // Show the suggestions list
                        names.forEach(item => {
                            const div = document.createElement('div');
                            div.textContent = `${item.GLName} - ${item.GlAlias}`;  // Show both values
                            div.onclick = function () {
                                document.getElementById('DEbank-name-input').value = item.GLName;  // Set the input value to BankName
                                bankNamesList.style.display = 'none';  // Hide the suggestions list
                            };
                            bankNamesList.appendChild(div);
                        });
                    } else {
                        const noResult = document.createElement('div');
                        noResult.textContent = 'No matching BankNames found';
                        bankNamesList.appendChild(noResult);
                    }
                }
