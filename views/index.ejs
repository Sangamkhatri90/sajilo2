                // Function to reset the ledger sub-group selection and input fields
                function resetSelection8() {
                    selectedLedgerSubGroup = null;  // Clear the selected ledger sub-group

                    // Clear input fields
                    document.getElementById('ledgermsub-id').value = '';  // Clear the Sub Group Name input field
                    document.getElementById('ledgermsubalias').value = '';  // Clear the Alias input field
                    document.getElementById('ledgermsubaltalias').value = '';  // Clear the Alt Alias input field
                    document.getElementById('ledgermsub-remark').value = '';  // Clear the Remarks input field
                    document.getElementById('ledgermsub-deprication').value = '';  // Clear the Depreciation Percent field
                    document.getElementById('LedgerGroup2').value = '';// Clear the Group field
                    // Optionally clear any other UI elements like the displayed ledger sub-group list
                    const ledgerSubGroupListDiv = document.getElementById('ledgerSubGroupList');
                    ledgerSubGroupListDiv.innerHTML = '';  // Clear any remaining suggestions
                    ledgerSubGroupListDiv.style.display = 'none';  // Hide the ledger sub-group list if needed
                }

                // Function to delete the selected ledger sub-group
                function deleteLedgerSubGroup() {
                    if (deletionInProgress) {
                        return; // Prevent the deletion if it's already in progress
                    }

                    deletionInProgress = true;  // Set the flag to indicate that deletion is in progress

                    const ledgerSubGroupName = document.getElementById('ledgermsub-id').value.trim();

                    // If no ledger sub-group is selected, show the list of ledger sub-groups
                    if (!selectedLedgerSubGroup && !ledgerSubGroupName) {
                        showLedgerSubGroupsList();  // Show the list of ledger sub-groups to choose from
                        deletionInProgress = false;  // Reset the flag
                        return;  // Prevent further actions until a ledger sub-group is selected
                    }

                    // If a ledger sub-group is selected, proceed with deletion
                    const subGroupNameToDelete = selectedLedgerSubGroup ? selectedLedgerSubGroup.SubGrpName : ledgerSubGroupName;

                    // If a ledger sub-group is still not selected, show error and prevent deletion
                    if (!subGroupNameToDelete) {
                        alshowCustomAlertert("Sub Group Name is required.");
                        deletionInProgress = false;  // Reset the flag
                        return;  // Prevent further actions
                    }

                    // Get the LgrSubGrpID from the selected sub-group
                    const LgrSubGrpID = selectedLedgerSubGroup ? selectedLedgerSubGroup.LgrSubGrpID : null;

                    // If no LgrSubGrpID is available, show an error and prevent further actions
                    if (!LgrSubGrpID) {
                        showCustomAlert("Selected ledger sub-group is missing LgrSubGrpID.");
                        deletionInProgress = false;  // Reset the flag
                        return;
                    }

                    // Step 1: Check if the selected sub-group has dependencies (check if it's being used in the dbo.tbLedgerMaster)
                    fetch(`/checkLedgerSubGroupDependencies/${LgrSubGrpID}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.success === false) {
                                showCustomAlert(`Cannot delete sub-group "${subGroupNameToDelete}" as it is being used in another part of the system.`);
                                resetSelection8();  // Reset the form and selection after showing the alert
                                deletionInProgress = false;  // Reset the flag
                                return;
                            }

                            showCustomConfirm(
                                `Are you sure you want to delete the route "${subGroupNameToDelete}"?`,
                                () => {
                                    fetch('/deleteLedgerSubGroup', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ subGroupName: subGroupNameToDelete })
                                    })
                                        .then(response => response.json())
                                        .then(data => {
                                            if (data.success) {
                                                showCustomAlert(`Ledger sub-group "${subGroupNameToDelete}" deleted successfully.`);
                                                removeFromList(subGroupNameToDelete);  // Remove the deleted ledger sub-group from the list
                                                resetSelection8();  // Reset selection and inputs after successful deletion
                                            } else {
                                                showCustomAlert(data.message || "Failed to delete the ledger sub-group.");
                                                resetSelection8();  // Reset selection even if deletion failed
                                            }
                                            deletionInProgress = false;  // Reset the flag
                                        })
                                        .catch(error => {
                                            console.error('Error deleting ledger sub-group:', error);
                                            showCustomAlert("Error deleting ledger sub-group.");
                                            resetSelection8();  // Ensure we reset even in case of error
                                            deletionInProgress = false;  // Reset the flag
                                        });
                                }, () => {
                                    // On cancel
                                    resetSelection8();
                                    deletionInProgress = false;  // Reset the flag
                                }
                            );
                        })
                        .catch(error => {
                            console.error('Error checking dependencies:', error);
                            showCustomAlert('Error checking dependencies.');
                            deletionInProgress = false;  // Reset the flag
                        });
                }

                // Function to remove the deleted ledger sub-group from the displayed list
                function removeFromList(subGroupName) {
                    const ledgerSubGroupListDiv = document.getElementById('ledgerSubGroupList');
                    const items = ledgerSubGroupListDiv.querySelectorAll('.suggestion-item');
                    items.forEach(item => {
                        if (item.textContent.includes(subGroupName)) {
                            item.remove(); // Remove the ledger sub-group from the displayed list
                        }
                    });
                }

                // Example of how to call showLedgerSubGroupsList() when clicking on the "Delete" button
                document.getElementById('ledgermsub-delete-button').addEventListener('click', function () {
                    deleteLedgerSubGroup();  // Call the delete function when delete button is clicked
                });

