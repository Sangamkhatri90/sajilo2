                                    const amountVal = item.amount || 0;
                                    totalAmount += amountVal;

                                    const formattedAmount = amountVal < 0
                                        ? `(${Math.abs(amountVal).toFixed(2)})`
                                        : amountVal.toFixed(2);

                                    htmlRows += `
                <tr>
                    <td>${ledgerIndex}</td>
                    <td>${item.ledgerName}</td>
                    <td>${item.ledgerAlias}</td>
                    <td>${formattedAmount}</td>
                </tr>
