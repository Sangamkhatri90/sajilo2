            <script>
                let allLedgersubGroups1Edit = [];
                let filteredLedgersubGroups1Edit = [];
                let allLedgerGroups1Edits = [];
                let filteredLedgerGroups1Edits = [];

                // Fetch Ledger Groups
                function fetchLedgerGroups1Edit(isInitialFocus) {
                    const LedgerGroups1List = document.getElementById('LedgerGroups1ListEditDIV');
                    const inputField = document.getElementById('LedgerGroup1Edit');
                    LedgerGroups1List.innerHTML = '';
                    LedgerGroups1List.style.display = 'none';

                    if (allLedgerGroups1Edits.length === 0 || isInitialFocus) {
                        fetch('/fetchLedgerGroup1Edit')
                            .then(response => response.json())
                            .then(data => {
                                if (data.ledgerGroups && data.ledgerGroups.length > 0) {
                                    allLedgerGroups1Edits = data.ledgerGroups;
                                    filteredLedgerGroups1Edits = [...allLedgerGroups1Edits];
                                    displayLedgerGroups1Edit(filteredLedgerGroups1Edits);
                                } else {
                                    const noResult = document.createElement('div');
                                    noResult.textContent = 'No Ledger Groups found';
                                    noResult.style.color = 'gray';
                                    LedgerGroups1List.appendChild(noResult);
                                }
                            })
                            .catch(error => {
                                console.error('Error fetching Ledger Groups:', error);
                                const errorMessage = document.createElement('div');
                                errorMessage.textContent = 'Error fetching Ledger Groups';
                                errorMessage.style.color = 'red';
                                LedgerGroups1List.appendChild(errorMessage);
                            });
                    } else {
                        displayLedgerGroups1Edit(filteredLedgerGroups1Edits);
                    }
                }

                function filterLedgerGroups1Edit() {
                    const input = document.getElementById('LedgerGroup1Edit').value.toLowerCase();
                    if (input === '') {
                        filteredLedgerGroups1Edits = [...allLedgerGroups1Edits];
                    } else {
                        filteredLedgerGroups1Edits = allLedgerGroups1Edits.filter(item =>
                            item.GrpName.toLowerCase().includes(input) || item.GrpAlias.toLowerCase().includes(input)
                        );
                    }
                    displayLedgerGroups1Edit(filteredLedgerGroups1Edits);
                }

                function displayLedgerGroups1Edit(groups) {
                    const LedgerGroups1List = document.getElementById('LedgerGroups1ListEditDIV');
                    LedgerGroups1List.innerHTML = '';

                    groups.sort((a, b) => a.GrpName.localeCompare(b.GrpName));

                    const closeButton = document.createElement('button');
                    closeButton.textContent = 'X';
                    closeButton.className = 'close-button';
                    closeButton.onclick = function (event) {
                        event.preventDefault();
                        LedgerGroups1List.style.display = 'none';
                    };
