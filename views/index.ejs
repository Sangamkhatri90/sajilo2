            <script>
                // Function to make the div movable
                function makeDivMovable(divId, headerId) {
                    const div = document.getElementById(divId);
                    const header = document.getElementById(headerId);

                    // Variables for drag functionality
                    let isDragging = false;
                    let offsetX, offsetY;

                    // Event listener for mouse down (to initiate drag)
                    header.addEventListener('mousedown', function (e) {
                        isDragging = true;
                        offsetX = e.clientX - div.offsetLeft;
                        offsetY = e.clientY - div.offsetTop;
                        document.body.style.cursor = 'move';
                    });

                    // Event listener for mouse move (to update position while dragging)
                    document.addEventListener('mousemove', function (e) {
                        if (isDragging) {
                            div.style.left = e.clientX - offsetX + 'px';
                            div.style.top = e.clientY - offsetY + 'px';
                        }
                    });

                    // Event listener for mouse up (to stop dragging)
                    document.addEventListener('mouseup', function () {
                        isDragging = false;
                        document.body.style.cursor = 'default';
                    });
                }

