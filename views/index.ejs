                            modal.style.height = "100%";
                            modal.style.background = "rgba(0,0,0,0.5)";
                            modal.style.display = "flex";
                            modal.style.justifyContent = "center";
                            modal.style.alignItems = "center";
                            modal.style.zIndex = "9999";

                            const modalContent = document.createElement("textarea");
                            modalContent.style.width = "80%";
                            modalContent.style.height = "70%";
                            modalContent.style.padding = "10px";
                            modalContent.style.fontFamily = "monospace";
                            modalContent.value = textContent;

                            // Close button
                            const closeBtn = document.createElement("button");
                            closeBtn.textContent = "Close";
                            closeBtn.style.marginTop = "10px";
                            closeBtn.style.backgroundColor = 'red';
                            closeBtn.style.marginRight = "10px";
                            closeBtn.addEventListener("click", () => document.body.removeChild(modal));

                            // Download button
                            const downloadBtn = document.createElement("button");
                            downloadBtn.textContent = "Download";
                            downloadBtn.style.backgroundColor = 'green'
                            downloadBtn.style.marginTop = "10px";
                            downloadBtn.addEventListener("click", () => {
                                const blob = new Blob([modalContent.value], { type: "text/plain" });
                                const url = URL.createObjectURL(blob);
                                const link = document.createElement("a");
                                link.href = url;
                                link.download = `TransferSummary_${Date.now()}.txt`;
                                document.body.appendChild(link);
                                link.click();
                                document.body.removeChild(link);
                            });

                            // Container for textarea + buttons
                            const container = document.createElement("div");
                            container.style.background = "#fff";
                            container.style.padding = "20px";
                            container.style.borderRadius = "8px";
                            container.style.width = "85%";
                            container.style.maxHeight = "100%";
                            container.style.height = "300px";
                            container.style.display = "flex";
                            container.style.flexDirection = "column";
                            container.style.alignItems = "stretch";
                            container.style.justifyContent = "space-between";

                            const btnWrapper = document.createElement("div");
                            btnWrapper.style.display = "flex";
                            btnWrapper.style.justifyContent = "space-between";
                            btnWrapper.appendChild(downloadBtn);
                            btnWrapper.appendChild(closeBtn);

                            container.appendChild(modalContent);
                            container.appendChild(btnWrapper);
                            modal.appendChild(container);
                            document.body.appendChild(modal);

                        } catch (err) {
                            console.error("❌ Error during transfer process:", err);
                            alert("An unexpected error occurred while processing the transfer.");
                        } finally {
                            transferBtn.disabled = false;
                            transferBtn.textContent = "Transfer";
                        }
                    });
                });
