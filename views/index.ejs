                function initTableDropdownDENew(tableId) {
                    const table = document.getElementById(tableId);

                    table.addEventListener('click', async (e) => {
                        const cell = e.target.closest('td');
                        if (!cell) return;

                        const cellIndex = cell.cellIndex;
                        const row = cell.parentElement;
                        const rowIndex = row.rowIndex - 1;

                        // Dr column (colIndex 1) → auto set Dr + serial number
                        if (cellIndex === 1) {
                            cell.textContent = "Dr";
                            row.cells[0].textContent = rowIndex + 1; // Auto serial number in colIndex 0
                            return;
                        }

                        // Account Head column (index 2)
                        if (cellIndex === 2) {
                            activeCellDENew = cell;
                            await loadPostingLedgersDENew();
                            const opts = allPostingLedgersDENew.map(item => `${item.GLName}`);
                            showDropdownDENew(opts, cell);
                            row.cells[1].textContent = 'Dr'; // Auto serial number in colIndex 0
                            row.cells[0].textContent = rowIndex + 1; // Auto serial number in colIndex 0
                        }

                        // Sub Head column (index 3)
                        if (cellIndex === 3) {
                            const acchead = row.cells[2]?.textContent.trim();
                            if (!acchead) {
                                alert("Please fill the Account Head first.");
                                return;
                            }
                            activeCellDENew = cell;
                            await loadPostingLedgersDENew();
                            const opts = allPostingLedgersSubDENew.map(item => `${item.SLName}`);
                            showDropdownDENew(opts, cell);
                            row.cells[1].textContent = 'Dr'; // Auto serial number in colIndex 0
                            row.cells[0].textContent = rowIndex + 1; // Auto serial number in colIndex 0
                        }
                        if (cellIndex === 4 || cellIndex === 5) {
                            const oldValue = cell.textContent.trim();
                            cell.innerHTML = `<input type="number" min="0" step="0.01" value="${oldValue}" style=" width: 30px;
               height: 2vh;
               padding: 2px;
               box-sizing: border-box;
               border: none;
               outline: none;
               font-size: inherit;
               font-family: inherit;
               text-align: center;
               background-color: transparent;
           ">`;
                            const input = cell.querySelector('input');
                            input.focus();
                            input.select();

                            // When user leaves input, save the value
                            input.addEventListener('blur', () => {
                                cell.textContent = input.value || '';
                            });

                            // Allow pressing Enter to save
                            input.addEventListener('keydown', (ev) => {
                                if (ev.key === 'Enter') {
                                    input.blur();
                                }
                            });
                            row.cells[1].textContent = 'Dr'; // Auto serial number in colIndex 0
                            row.cells[0].textContent = rowIndex + 1; // Auto serial number in colIndex 0
                        }

                    });
                }

                function showDropdownDENew(options, cell) {
                    if (!Array.isArray(options)) {
                        console.error('Options is not an array:', options);
                        options = [];
                    }

                    currentOptionsDENew = options;
                    renderDropdownOptionsDENew(options);

                    const rect = cell.getBoundingClientRect();
                    dropdownDENew.style.top = `${rect.bottom + window.scrollY}px`;
                    dropdownDENew.style.left = `${rect.left + window.scrollX}px`;
                    dropdownDENew.style.width = `${rect.width}px`;
                    dropdownDENew.style.display = 'block';

                    searchDENew.value = '';
                    searchDENew.focus();
                }

                function renderDropdownOptionsDENew(options) {
                    optionsContainerDENew.innerHTML = '';
                    options.forEach(item => {
                        const div = document.createElement('div');
