                <script>
                    document.getElementById('myForm48').addEventListener('submit', async function (event) {
                        event.preventDefault();

                        try {
                            const response = await fetch('/api/pearls/protectionANDExpenditureSection'); // single backend call
                            if (!response.ok) throw new Error('Failed to fetch PEARLS data');

                            const data = await response.json();
                            const raw = data.raw;

                            // -----------------------------
                            // P SECTION (uses P1, P2, P3)
                            // -----------------------------
                            const numerator = raw.totalAllowance;

                            document.getElementById('p1_numerator').textContent = numerator.toFixed(2);
                            document.getElementById('p1_denominator').textContent = (raw.Over12Months || 0).toFixed(2);
                            document.getElementById('p1_result').textContent = data.P1.toFixed(2) + '%';

                            document.getElementById('p2_numerator').textContent = numerator.toFixed(2);
                            document.getElementById('p2_denominator').textContent = (raw.Between1And12Months || 0).toFixed(2);
                            document.getElementById('p2_result').textContent = data.P2.toFixed(2) + '%';

                            document.getElementById('p3_numerator').textContent = numerator.toFixed(2);
                            document.getElementById('p3_denominator').textContent = (raw.TotalDelinquent || 0).toFixed(2);
                            document.getElementById('p3_result').textContent = data.P3.toFixed(2) + '%';

                            // -----------------------------
                            // E SECTION (so far only E1)
                            // -----------------------------
                            document.getElementById('e1_numerator').textContent = raw.TotalLoan.toFixed(2);
                            document.getElementById('e1_denominator').textContent = (data.E.TotalAssets || 0).toFixed(2);
                            document.getElementById('e1_result').textContent = data.E.E1.toFixed(2) + '%';

                            console.log('PEARLS data loaded:', data);
                            // **Make the table visible**
                            document.getElementById('pearlsreportDiv').style.display = 'block';


                        } catch (err) {
                            console.error(err);
                            alert('Error loading PEARLS data');
                        }
                    });
                </script>






