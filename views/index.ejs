                                data.forEach((row, index) => {
                                    const tr = document.createElement('tr');
                                    tr.innerHTML = `
                    <td><input type="checkbox" class="ReSavedAccounts" value="${row.SLName}|${row.SlAlias}"></td>
                    <td>${index + 1}</td>
                    <td>${row.SLName}</td>
                    <td>${row.SlAlias}</td>
                `;
                                    tableBody.appendChild(tr);
                                });

