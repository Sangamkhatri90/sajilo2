            <script>
                // Frontend JavaScript Code

                let selectedRecord = null; // To store the selected database record

                // Fetch records from the backend
                function showRecordsList() {
                    const recordListDiv = document.getElementById('deleteOrganizationslist');
                    recordListDiv.innerHTML = ''; // Clear any existing content
                    recordListDiv.style.display = 'none'; // Hide the list initially

                    fetch('/fetchOrganizations')  // Call the backend route
                        .then(response => response.json())
                        .then(data => {
                            // Receive real data, it will be displayed here
                            if (data.organizations && data.organizations.length > 0) {
                                displayRecords(data.organizations);
                            } else {
                                const noResult = document.createElement('div');
                                noResult.textContent = 'No records found';
                                recordListDiv.appendChild(noResult);
                            }

                            // Show the suggestion list
                            recordListDiv.style.display = 'block';
                        })
                        .catch(error => {
                            console.error('Error fetching records:', error);
                            const errorMessage = document.createElement('div');
                            errorMessage.textContent = 'Error fetching records';
                            recordListDiv.appendChild(errorMessage);
                        });
                }

                // Display fetched records in a list
                function displayRecords(records) {
                    const recordListDiv = document.getElementById('deleteOrganizationslist');
                    recordListDiv.innerHTML = ''; // Clear previous suggestions

                    // Create an "X" button to close the list
                    const closeButton = document.createElement('button');
                    closeButton.textContent = 'X';
                    closeButton.className = 'close-button'; // You can style it with this class
                    closeButton.onclick = function (event) {
                        event.preventDefault();  // Prevent default action
                        recordListDiv.style.display = 'none'; // Hide the list
                    };

                    recordListDiv.appendChild(closeButton); // Add the close button to the list

                    // Sort alphabetically
                    records.sort((a, b) => a.OrgName.localeCompare(b.OrgName));

                    recordListDiv.style.display = 'block'; // Show the suggestions list
                    records.forEach(record => {
                        const div = document.createElement('div');
                        div.className = 'suggestion-item';
                        div.textContent = `${record.OrgName} - ${record.OrgAlias}`; // Show both OrgName and OrgAlias

                        // When a record is clicked, fill the input fields
                        div.onclick = function () {
                            document.getElementById('orgm-name').value = record.OrgName;
                            document.getElementById('org-alias').value = record.OrgAlias;
                            selectedRecord = record;  // Store the selected record
                            recordListDiv.style.display = 'none'; // Hide the suggestion list

                            // Fetch additional data from the backend based on the selected OrgName
                            fetchAdditionalData(record.OrgName);
                            fetchFiscalDates(record.OrgAlias)
                        };
                        recordListDiv.appendChild(div);
                    });
                }

                // Function to fetch additional data based on the selected OrgName
                function fetchAdditionalData(orgName) {
                    fetch(`/fetchAdditionalData?orgName=${orgName}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                const orgm_active = document.getElementById('orgm-active');
                                orgm_active.checked = data.status;

                                const methodSelectOrg = document.getElementById('org-drive');
                                const drive = data.drive;
                                const optionsSchedule = methodSelectOrg.options;
                                let methodSelectedOrg = false;

                                // Loop through the options to match the value (trim whitespace and ensure case consistency)
                                for (let i = 0; i < optionsSchedule.length; i++) {
                                    if (optionsSchedule[i].value.trim() === drive.trim()) {
                                        methodSelectOrg.selectedIndex = i;  // Set the correct index
                                        methodSelectedOrg = true;
                                        break;
                                    }
                                }

                                if (!methodSelectedOrg) {
                                    console.log('No matching method found in dropdown:', drive);
                                    methodSelectOrg.selectedIndex = -1; // Optionally set a default value
                                }

                                // Log the selected schedule for debugging
                                console.log('Schedule selected:', methodSelectOrg.value);

                                // Populate the additional fields with the data returned from the backend
                                document.getElementById('org-address1').value = data.field1;
                                document.getElementById('org-address2').value = data.field2;
                                document.getElementById('org-pan').value = data.pan;
                                document.getElementById('org-email').value = data.email;
                                document.getElementById('org-fax').value = data.fax;
                                document.getElementById('org-phone1').value = data.phone1;
                                document.getElementById('org-phone2').value = data.phone2;
                                document.getElementById('org-remarks').value = data.remark;
                            } else {
                                console.error("Error fetching additional data:", data.message);
                            }
                        })
                        .catch(error => {
                            console.error("Error fetching additional data:", error);
                        });
                }
                function fetchFiscalDates(OrgAlias) {
                    fetch(`/fetchAdditionalDateFiscalYear?orgName=${encodeURIComponent(OrgAlias)}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                const setDateField = (id, dateValue) => {
                                    const el = document.getElementById(id);
                                    if (el) el.value = dateValue || '';
                                };

                                setDateField('TransactionStartDate', data.transactionStartDate);
                                setDateField('fiscalYearStart', data.fiscalYearStart);
                                setDateField('fiscalYearEnd', data.fiscalYearEnd);

                                console.log("Fiscal dates populated successfully:", data);
                            } else {
                                console.error("Failed to fetch fiscal dates:", data.message);
                            }
                        })
                        .catch(error => {
                            console.error("Error fetching fiscal dates:", error);
                        });
                }


                // Delete record
                function deleteRecord() {
                    const recordName = document.getElementById('orgm-name').value.trim();
                    const recordAlias = document.getElementById('org-alias').value.trim();

                    // If no record is selected, show the records list
                    if (!selectedRecord && !recordName) {
                        showRecordsList(); // Show the records list to choose from
                        return;
                    }

                    const recordToDelete = selectedRecord ? selectedRecord.OrgName : recordName;

                    if (!recordToDelete) {
                        showCustomAlert("Record name and details are required.");
                        return; // Prevent deletion if no record is selected
                    }

                    // Ensure the orgID exists in localStorage
                    const selectedOrgID = localStorage.getItem('selectedOrgID');
                    if (!selectedOrgID) {
                        showCustomAlert("Organization ID is not available.");
                        return;
                    }

                    // Before proceeding with deletion, check if the organization is in use
                    fetch('/checkIfInUse', {  // Check if organization is currently in use
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ orgName: recordToDelete, orgID: selectedOrgID, orgAlias: recordAlias })
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (!data.success) {
                                // If the organization is in use, show the message
                                showCustomAlert(data.message);
                                resetSelection10();
                            } else {
                                // Store the retrieved orgID of the selected database
                                const orgID = data.SorgID;

                                // Enhanced confirmation dialog for deletion with a warning
                                showCustomConfirm(
                                    `Are you sure you want to delete the this organization with alias "${recordAlias}"?`,
                                    () => {
                                        // Send the delete request to the server
                                        fetch('/deleteOrganization', { // Replace with the actual endpoint for deleting a record
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ recordToDeletee: recordAlias, orgID: orgID, confirmDelete: 'true' }) // Adding confirmDelete
                                        })
                                            .then(response => response.json())
                                            .then(data => {
                                                if (data.success) {
                                                    showCustomAlert(`Record "${recordName}" deleted successfully.`);
                                                    resetSelection10(); // Reset the form and selection after successful deletion
                                                } else {
                                                    showCustomAlert(data.message || "Failed to delete the record.");
                                                }
                                            })
                                            .catch(error => {
                                                console.error('Error deleting record:', error);
                                                showCustomAlert("Error deleting record.");
                                            });
                                    },
                                    () => {
                                        // On cancel
                                        resetSelection10();
                                    }
                                );
                            }
                        })
                        .catch(error => {
                            console.error('Error checking organization status:', error);
                        });
                }

                // Reset selection and input fields
                function resetSelection10() {
                    selectedRecord = null;

                    const idsToClear = [
                        'orgm-name', 'org-alias', 'org-address1', 'org-address2',
                        'org-pan', 'org-email', 'org-fax', 'org-phone1',
                        'org-phone2', 'org-remarks', 'orgm-select'
                    ];

                    idsToClear.forEach(id => {
                        const el = document.getElementById(id);
                        if (el) el.value = '';
                    });

                    const checkbox = document.getElementById('orgm-active');
                    if (checkbox) checkbox.checked = false;

                    const recordListDiv = document.getElementById('deleteOrganizationslist');
                    if (recordListDiv) {
                        recordListDiv.innerHTML = '';
                        recordListDiv.style.display = 'none';
                    }
                }

            </script>
