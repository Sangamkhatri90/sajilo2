                    if (num === 0) return 'Zero';
                    if (num < 20) return a[num];
                    if (num < 100) return b[Math.floor(num / 10)] + (num % 10 ? '-' + a[num % 10] : '');

                    let word = '', unitIndex = 0;
                    while (num > 0) {
                        const chunk = num % 1000;
                        if (chunk) word = chunkToWords(chunk, a, b) + (g[unitIndex] ? ' ' + g[unitIndex] : '') + ' ' + word;
                        num = Math.floor(num / 1000);
                        unitIndex++;
                    }
                    return word.trim();
                }

                function chunkToWords(chunk, a, b) {
                    const hundred = Math.floor(chunk / 100);
                    const remainder = chunk % 100;
                    return (hundred ? a[hundred] + ' Hundred' + (remainder ? ' and ' : '') : '') + (remainder < 20 ? a[remainder] : b[Math.floor(remainder / 10)] + (remainder % 10 ? '-' + a[remainder % 10] : ''));
                }

                // Function to update total and total in words
                function updateTotal1() {
                    const amount = parseFloat(document.getElementById("Maintransamount").value) || 0;
                    const penalty = parseFloat(document.getElementById("Maintranspenalty").value) || 0;
                    const rebate = parseFloat(document.getElementById("Maintransrebate").value) || 0;
                    const total = amount + penalty - rebate;

                    // Display the total
                    document.getElementById("Maintranstotal").value = total;

                    // Display the total in words
                    if (!isNaN(total)) {
                        document.getElementById("MaintranstotalInWords").value = numberToWords(Math.floor(total));
                    } else {
                        document.getElementById("MaintranstotalInWords").value = "";
                    }
                }


                // Function to update total and total in words
                function updateTotal() {
                    const amount = parseFloat(document.getElementById("ccaccedit-amount").value) || 0;
                    const penalty = parseFloat(document.getElementById("ccaccedit-penalty").value) || 0;
                    const rebate = parseFloat(document.getElementById("ccaccedit-rebate").value) || 0;
                    const total = amount + penalty - rebate;

                    // Display the total
                    document.getElementById("ccacc-total").value = total;

                    // Display the total in words
                    if (!isNaN(total)) {
                        document.getElementById("ccacc-totalInWords").value = numberToWords(Math.floor(total));
                    } else {
                        document.getElementById("ccacc-totalInWords").value = "";
                    }
                }

            </script>

