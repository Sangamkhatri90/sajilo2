            <script>
                let allPenaltyList = [];  // Store both GLName and GLAlias fetched from the server for PenaltyMasterNew
                let filteredPenaltyList = [];  // Store filtered GLNames and GLAlias based on user input for PenaltyMasterNew

                // Function to fetch GLNames and GLAlias for PenaltyMasterNew from the server and display them as suggestions
                function fetchPenaltyList(isInitialFocus) {
                    const penaltyListDiv = document.getElementById('PenaltyMasterNewlistDiv');
                    penaltyListDiv.innerHTML = '';  // Clear any existing suggestions
                    penaltyListDiv.style.display = 'none';  // Hide suggestions list initially

                    if (allPenaltyList.length === 0 || isInitialFocus) {
                        // Fetch GLNames and GLAlias for PenaltyMasterNew from the backend if not already fetched
                        fetch('/fetchListsForPenaltyNew')  // Updated route to reflect the new path
                            .then(response => response.json())
                            .then(data => {
                                if (data.PenaltyList && data.PenaltyList.length > 0) {
                                    allPenaltyList = data.PenaltyList;  // Store fetched GLNames and GLAlias
                                    filteredPenaltyList = [...allPenaltyList];  // Initially show all GLNames
                                    displayPenaltyList(filteredPenaltyList);  // Display the full list on initial focus
                                } else {
                                    const noResult = document.createElement('div');
                                    noResult.textContent = 'No GLNames found';
                                    penaltyListDiv.appendChild(noResult);
                                }
                            })
                            .catch(error => {
                                console.error('Error fetching GLNames:', error);
                                const errorMessage = document.createElement('div');
                                errorMessage.textContent = 'Error fetching GLNames';
                                penaltyListDiv.appendChild(errorMessage);
                            });
                    } else {
                        displayPenaltyList(filteredPenaltyList);  // Display the filtered list
                    }
                }

                // Function to filter GLNames and GLAlias based on user input for PenaltyMasterNew
                function filterPenaltyList() {
                    const input = document.getElementById('PenaltyMasterNew').value.toLowerCase();
                    if (input === '') {
                        filteredPenaltyList = [...allPenaltyList];  // Show the full list when input is empty
                    } else {
                        filteredPenaltyList = allPenaltyList.filter(item =>
                            item.GLName.toLowerCase().includes(input) || item.GLAlias.toLowerCase().includes(input)
                        );
                    }
                    displayPenaltyList(filteredPenaltyList);
                }

                // Function to display GLNames and GLAlias in the suggestion list for PenaltyMasterNew
                function displayPenaltyList(names) {
                    const penaltyListDiv = document.getElementById('PenaltyMasterNewlistDiv');
