                let allPenaltyListForCopy = [];  // Store both GLName and GLAlias fetched from the server for PenaltyMasterCopy
                let filteredPenaltyListForCopy = [];  // Store filtered GLNames and GLAliases based on user input for PenaltyMasterCopy

                // Function to fetch GLNames and GLAlias for PenaltyMasterCopy from the server and display them as suggestions
                function fetchPenaltyListForCopy(isInitialFocus) {
                    const penaltyListDiv = document.getElementById('PenaltyMasterCopylistDiv');
                    penaltyListDiv.innerHTML = '';  // Clear any existing suggestions
                    penaltyListDiv.style.display = 'none';  // Hide suggestions list initially

                    if (allPenaltyListForCopy.length === 0 || isInitialFocus) {
                        // Fetch GLNames and GLAliases for PenaltyMasterCopy from the backend if not already fetched
                        fetch('/fetchListsForPenaltyCopy')  // Updated route to reflect the new path
                            .then(response => response.json())
                            .then(data => {
                                if (data.PenaltyList && data.PenaltyList.length > 0) {
                                    allPenaltyListForCopy = data.PenaltyList;  // Store fetched GLNames and GLAliases
                                    filteredPenaltyListForCopy = [...allPenaltyListForCopy];  // Initially show all GLNames
                                    displayPenaltyListForCopy(filteredPenaltyListForCopy);  // Display the full list on initial focus
                                } else {
                                    const noResult = document.createElement('div');
                                    noResult.textContent = 'No GLNames found';
                                    penaltyListDiv.appendChild(noResult);
                                }
                            })
                            .catch(error => {
                                console.error('Error fetching GLNames:', error);
                                const errorMessage = document.createElement('div');
                                errorMessage.textContent = 'Error fetching GLNames';
                                penaltyListDiv.appendChild(errorMessage);
                            });
                    } else {
                        displayPenaltyListForCopy(filteredPenaltyListForCopy);  // Display the filtered list
                    }
                }

                // Function to filter GLNames and GLAlias based on user input for PenaltyMasterCopy
                function filterPenaltyListForCopy() {
                    const input = document.getElementById('CopyAccTypePenaltySetAT').value.toLowerCase();
                    if (input === '') {
                        filteredPenaltyListForCopy = [...allPenaltyListForCopy];  // Show the full list when input is empty
                    } else {
                        filteredPenaltyListForCopy = allPenaltyListForCopy.filter(item =>
                            item.GLName.toLowerCase().includes(input) || item.GLAlias.toLowerCase().includes(input)
                        );
                    }
                    displayPenaltyListForCopy(filteredPenaltyListForCopy);
                }

                // Function to display GLNames and GLAlias in the suggestion list for PenaltyMasterCopy
                function displayPenaltyListForCopy(names) {
                    const penaltyListDiv = document.getElementById('PenaltyMasterCopylistDiv');
                    penaltyListDiv.innerHTML = '';  // Clear previous suggestions

                    // Create and append the close button
                    const closeButton = document.createElement('button');
                    closeButton.textContent = 'X';
                    closeButton.onclick = function (event) {
                        event.preventDefault();
                        penaltyListDiv.style.display = 'none';  // Hide the suggestions list when the close button is clicked
                    };
                    penaltyListDiv.appendChild(closeButton);  // Append the close button to the list

                    if (names.length > 0) {
                        penaltyListDiv.style.display = 'block';  // Show the suggestions list
                        names.forEach(item => {
                            const div = document.createElement('div');
                            div.textContent = `${item.GLName} - ${item.GLAlias}`;  // Show both GLName and GLAlias
                            div.onclick = function () {
                                document.getElementById('CopyAccTypePenaltySetAT').value = item.GLName;  // Set the input value to GLName
                                penaltyListDiv.style.display = 'none';  // Hide the suggestions list
                            };
                            penaltyListDiv.appendChild(div);
                        });
                    } else {
                        const noResult = document.createElement('div');
                        noResult.textContent = 'No matching GLNames found';
                        penaltyListDiv.appendChild(noResult);
                    }
                }
