                                data.forEach((row, index) => {
                                    // Convert to numbers safely
                                    const principal = Number(row.Principal) || 0;
                                    const interest = Number(row.Interest) || 0;
                                    const total = Number(row.Total) || 0;

                                    // Add to totals
