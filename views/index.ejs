                // Function to display ledger sub-groups in the suggestions
                function displayLedgerSubGroups(ledgerSubGroups) {
                    const ledgerSubGroupListDiv = document.getElementById('ledgerSubGroupList');
                    ledgerSubGroupListDiv.innerHTML = ''; // Clear previous suggestions

                    // Create an "×" button to close the list
                    const closeButton = document.createElement('button');
                    closeButton.textContent = '×';
                    closeButton.className = 'close-button';
                    closeButton.setAttribute('aria-label', 'Close suggestions list'); // Accessibility
                    closeButton.onclick = () => {
                        ledgerSubGroupListDiv.style.display = 'none';
                    };
                    ledgerSubGroupListDiv.appendChild(closeButton);

                    // Sort and populate the suggestions
                    ledgerSubGroups.sort((a, b) => a.SubGrpName.localeCompare(b.SubGrpName));
                    ledgerSubGroups.forEach(subGroup => {
                        const div = document.createElement('div');
                        div.className = 'suggestion-item';
                        div.textContent = `${subGroup.SubGrpName} - ${subGroup.SubGrpAlias}`;
                        div.onclick = () => {
                            selectedLedgerSubGroup = subGroup;
                            // Fill the form fields with the selected sub-group's data
                            document.getElementById('ledgermsub-id').value = subGroup.SubGrpName;
                            document.getElementById('ledgermsubalias').value = subGroup.SubGrpAlias;
                            document.getElementById('ledgermsubaltalias').value = subGroup.AltAlias;
                            document.getElementById('ledgermsub-remark').value = subGroup.Remarks;
                            document.getElementById('ledgermsub-deprication').value = subGroup.DepreciationPercent;

                            // Fetch GrpName from the server based on LgrGrpID and update LedgerGroup2 input field
                            fetchGrpName(subGroup.LgrGrpID);
                            // Hide the list
                            ledgerSubGroupListDiv.style.display = 'none';
                        };
                        ledgerSubGroupListDiv.appendChild(div);
                    });

                    ledgerSubGroupListDiv.style.display = 'block';
                }
                // Function to fetch GrpName based on LgrGrpID and update the input field
                function fetchGrpName(LgrGrpID) {
                    fetch(`/fetchGrpName/${LgrGrpID}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // Set the GrpName in the LedgerGroup2 input field
                                document.getElementById('LedgerGroup2').value = data.GrpName;
                            } else {
                                console.error('Error fetching GrpName:', data.message);
