                const closeDropdownDENew = document.getElementById('closeDropdownDENew');
                const optionsContainerDENew = document.getElementById('optionsContainerDENew');
                let activeCellDENew = null;
                let currentOptionsDENew = [];

                // Fetch Account Head & Sub Head lists
                async function loadPostingLedgersDENew() {
                    if (allPostingLedgersDENew.length === 0) {
                        const res = await fetch('/fetchPostingLedgerForNew');
                        const data = await res.json();
                        allPostingLedgersDENew = Array.isArray(data.postingLedgers) ? data.postingLedgers : [];
                    }

                    if (allPostingLedgersSubDENew.length === 0) {
                        const res = await fetch('/fetchPostingLedgerSubheadForNew');
                        const data = await res.json();
                        allPostingLedgersSubDENew = Array.isArray(data.subheadmemberlist) ? data.subheadmemberlist : [];
                    }
