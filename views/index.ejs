            <script>
                const ledgerCache = {};       // Stores all fetched ledgers per input ID
                const ledgerFiltered = {};    // Stores filtered ledgers per input ID

                function handleLedgerFocus(inputId, listId, fetchUrl, nameKey, aliasKey, includeAllOption = false) {
                    const listEl = document.getElementById(listId);
                    listEl.innerHTML = '';
                    listEl.style.display = 'none';

                    const allOption = includeAllOption ? [{ [nameKey]: "All", [aliasKey]: "All" }] : [];

                    if (!ledgerCache[inputId]) {
                        fetch(fetchUrl)
                            .then(res => res.json())
                            .then(data => {
                                if (data.postingLedgers && data.postingLedgers.length > 0) {
                                    ledgerCache[inputId] = data.postingLedgers;
                                    ledgerFiltered[inputId] = [...allOption, ...data.postingLedgers];
                                    displayLedgerSuggestions(inputId, listId, nameKey, aliasKey);
                                } else {
                                    listEl.innerHTML = `<div style="color:gray;">No data found</div>`;
                                }
                            })
                            .catch(err => {
                                console.error('Error fetching ledger data:', err);
                                listEl.innerHTML = `<div style="color:red;">Error fetching data</div>`;
                            });
                    } else {
                        ledgerFiltered[inputId] = [...allOption, ...ledgerCache[inputId]];
                        displayLedgerSuggestions(inputId, listId, nameKey, aliasKey);
                    }
                }

                function handleLedgerInput(inputId, listId, nameKey, aliasKey, includeAllOption = false) {
                    const inputVal = document.getElementById(inputId).value.toLowerCase();
                    const allData = ledgerCache[inputId] || [];
                    const allOption = includeAllOption ? [{ [nameKey]: "All", [aliasKey]: "All" }] : [];

                    if (inputVal === '') {
                        ledgerFiltered[inputId] = [...allOption, ...allData];
                    } else {
                        ledgerFiltered[inputId] = [
                            ...allOption,
                            ...allData.filter(item =>
                                item[nameKey].toLowerCase().includes(inputVal) || item[aliasKey].toLowerCase().includes(inputVal)
                            )
                        ];
                    }

                    ledgerFiltered[inputId].sort((a, b) => {
                        if (a[nameKey] === "All") return -1;
                        if (b[nameKey] === "All") return 1;
                        return a[nameKey].localeCompare(b[nameKey]);
                    });

                    displayLedgerSuggestions(inputId, listId, nameKey, aliasKey);
                }

                function displayLedgerSuggestions(inputId, listId, nameKey, aliasKey) {
                    const listEl = document.getElementById(listId);
                    listEl.innerHTML = '';

                    const closeBtn = document.createElement('button');
                    closeBtn.textContent = 'X';
                    closeBtn.className = 'close-button';
                    closeBtn.onclick = (e) => {
                        e.preventDefault();
                        listEl.style.display = 'none';
                    };
                    listEl.appendChild(closeBtn);

                    const list = ledgerFiltered[inputId] || [];
                    if (list.length > 0) {
                        listEl.style.display = 'block';
                        list.forEach(item => {
                            const div = document.createElement('div');
                            div.className = 'suggestion-item';
                            div.textContent = `${item[nameKey]} - ${item[aliasKey]}`;
                            div.title = `${item[nameKey]} - ${item[aliasKey]}`;
                            div.onclick = () => {
                                document.getElementById(inputId).value = item[nameKey];
                                listEl.style.display = 'none';
                            };
                            listEl.appendChild(div);
                        });
                    } else {
                        const noResult = document.createElement('div');
                        noResult.textContent = 'No matching results';
                        noResult.style.color = 'gray';
                        listEl.appendChild(noResult);
                    }
                }
            </script>


