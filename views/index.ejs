                function resetUDFForm() {

                    const ids = [
                        'UDFField', 'UDFModule', 'UDFType', 'UDFLength', 'UDForder',
                        'UDFremark'
                    ];

                    ids.forEach(id => document.getElementById(id).value = "");

                    const cbIds = [
                        'UDFDecimalCB', 'UDFItemwiseCB', 'UDFShowTotalCB',
                        'UDFMandatoryCB', 'UDFActiveCB'
