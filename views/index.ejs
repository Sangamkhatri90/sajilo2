            <script>
                document.getElementById('myForm29').addEventListener('submit', async function (event) {
                    event.preventDefault();

                    const showAlias = document.getElementById('frdr-show-alias').checked;
                    const fromDate = document.getElementById("FRDR-Datefrom").value;
                    const toDate = document.getElementById("FRDR-Dateto").value;
                    const divisionReportcontainer = document.getElementById("divisionReportTableContainer");



                    const formattedFrom = fromDate.replaceAll('-', '/');
                    const formattedTo = toDate.replaceAll('-', '/');






                    /* ---------- utilities ---------- */
                    let highestZIndex = 3;

                    const bringToFront = el => {
                        highestZIndex += 1;
                        el.style.zIndex = highestZIndex;
                    };

                    const makeDivMovable = div => {
                        let isDragging = false;
                        let offsetX, offsetY;

                        div.addEventListener('mousedown', e => {
                            if (['INPUT', 'TEXTAREA'].includes(e.target.tagName)) return;
                            e.preventDefault();
                            bringToFront(div);
                            const { left, top } = div.getBoundingClientRect();
                            offsetX = e.clientX - left;
                            offsetY = e.clientY - top;
                            isDragging = true;
                        });

                        document.addEventListener('mousemove', e => {
                            if (!isDragging) return;
                            div.style.position = 'absolute';
                            div.style.left = `${e.pageX - offsetX}px`;
                            div.style.top = `${e.pageY - offsetY}px`;
                        });

                        document.addEventListener('mouseup', () => { isDragging = false; });
                    };

                    /* ---------- closers ---------- */
                    [
                        { btn: 'divisionReportTableContainerXbtn', div: divisionReportcontainer },
                        { btn: 'divisionReportOKBtns', div: divisionReportcontainer },

                    ].forEach(({ btn, div }) => {
                        document.getElementById(btn)?.addEventListener('click', e => {
                            e.preventDefault();
                            div.style.display = 'none';
                        });
                    });

                    /* ---------- enable drag ---------- */
                    [divisionReportcontainer].forEach(makeDivMovable);




                    // fetch the flat list with both group & ledger info
                    const resp = await fetch('/api/DR/tablepop', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ fromDate: formattedFrom, toDate: formattedTo })
                    });
                    const data = await resp.json();
                    divisionReportcontainer.style.display = 'block';
                    // group them by group name
                    const groups = {};
                    data.forEach(item => {
                        const g = item["group name"] || 'Ungrouped';
                        if (!groups[g]) {
                            groups[g] = {
                                alias: item["group alias"] || '',
                                rows: [],
                                sums: { opening: 0, period: 0, total: 0 }
                            };
                        }
                        groups[g].rows.push(item);
                        groups[g].sums.opening += item.openingBalance;
                        groups[g].sums.period += item.period;
                        groups[g].sums.total += item.total;
                    });

                    // references
                    const thead = document.getElementById('divisionReportThead');
                    const tbody = document.getElementById('divisionReportTbody');

                    // clear old
                    thead.innerHTML = '';
                    tbody.innerHTML = '';

                    // build headers
                    const hdrs = ['S.No', 'Particular'];
                    if (showAlias) hdrs.push('Alias');
                    hdrs.push('Number', 'Opening Balance', 'Period', 'Total');

                    const headerRow = document.createElement('tr');
                    hdrs.forEach(h => {
                        const th = document.createElement('th');
                        th.textContent = h;
                        th.style.padding = '8px';
                        headerRow.appendChild(th);
                    });
                    thead.appendChild(headerRow);

                    // build body rows
                    let groupIndex = 1;
                    for (const [groupName, info] of Object.entries(groups)) {
                        // group header
                        const gr = document.createElement('tr');
                        const cellsGroup = [groupIndex, groupName];
                        if (showAlias) cellsGroup.push(info.alias);
                        cellsGroup.push('', '', '', '');  // empty numeric columns
                        cellsGroup.forEach(txt => {
                            const td = document.createElement('td');
                            td.textContent = txt;
                            td.style.padding = '8px';
                            td.style.fontWeight = 'bold';
                            gr.appendChild(td);
                        });
                        tbody.appendChild(gr);

                        // ledger rows
                        info.rows.forEach((item, idx) => {
                            const lr = document.createElement('tr');
                            const sno = `${groupIndex}.${idx + 1}`;
                            const cellsLedger = [sno, item.particular];
                            if (showAlias) cellsLedger.push(item.alias);
                            cellsLedger.push(
                                item.number,
                                item.openingBalance.toLocaleString(),
