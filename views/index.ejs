            <script>
                // Add event listener for the save button
                document.getElementById("myForm103").addEventListener("submit", function (event) {
                    // Get the value of the mobile input field
                    var mobileInput = document.getElementById("mas-mobile-number").value.trim();

                    // Check if the mobile input is empty
                    if (mobileInput === "") {
                        event.preventDefault();
                        showCustomAlert("Mobile number is necessary.");
                        document.getElementById("mas-mobile-number").focus();
                    }
                    // Check if the mobile input is exactly 10 digits long
                    else if (mobileInput.length !== 10) {
                        event.preventDefault();
                        showCustomAlert("Invalid mobile number. Please enter Correct number.");
                        document.getElementById("mas-mobile-number").focus();
                    }
                });

                // Real-time validation for mobile number
                document.getElementById("mas-mobile-number").addEventListener("input", function () {
                    var mobileInput = this.value;

                    // Remove any non-digit characters from the input
                    mobileInput = mobileInput.replace(/\D/g, "");

                    // If the input is longer than 10 characters, trim it to 10 characters
                    if (mobileInput.length > 10) {
                        mobileInput = mobileInput.substring(0, 10);
                    }

                    // Set the mobile input value with the updated value
                    this.value = mobileInput;

                    // Create the placeholder dynamically with the entered digits
                    var placeholder = '0000000000'; // Default placeholder with 10 zeros
                    var enteredDigits = mobileInput.split(''); // Convert entered digits to array

                    // Replace first '0's with the digits entered by the user
                    for (var i = 0; i < enteredDigits.length; i++) {
                        placeholder = placeholder.substring(0, i) + enteredDigits[i] + placeholder.substring(i + 1);
                    }

                    // Set the placeholder dynamically
                    this.setAttribute('placeholder', placeholder);
                });
            </script>
