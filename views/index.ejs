            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    fetch('/fiscal-master-years')
                        .then(response => {
                            if (!response.ok) throw new Error('Network response was not ok');
                            return response.json();
                        })
                        .then(data => {
                            const list = document.getElementById('fiscalYearLists');
                            list.innerHTML = ''; // Clear "Loading..." message

                            data.forEach(item => {
                                const listItem = document.createElement('li');
                                listItem.textContent = item;
                                listItem.classList.add("fiscalYearLists");

                                listItem.addEventListener('click', () => {
                                    const [startDate, endDate] = item.split(' - ');

                                    const formatForInput = (nepDate) => {
                                        const [dd, mm, yyyy] = nepDate.split('/');
                                        return `${yyyy}-${mm}-${dd}`; // for input[type="date"]
                                    };

                                    const formatForDisplay = (nepDate) => {
                                        const [dd, mm, yyyy] = nepDate.split('/');
                                        return `${yyyy}/${mm}/${dd}`; // for display elements
                                    };

                                    // Update all input fields with matching classes
                                    document.querySelectorAll('.start-date-local' && '#setfiscalstartyear').forEach(input => {
                                        if (input.tagName === 'INPUT') {
                                            input.value = formatForInput(startDate);
                                        }
                                        else {
                                            input.innerText = formatForInput(startDate);
                                        }

                                        console.log('hh', formatForInput(startDate))
                                    });

                                    document.querySelectorAll('.end-date-local' && '#setfiscalendyear').forEach(input => {
                                        input.value = formatForInput(endDate);
                                    });

                                    // Optional: update display divs too
                                    document.getElementById('startDateInput').textContent = `Fiscal Start Date: ${formatForDisplay(startDate)}`;
                                    document.getElementById('endDateInput').textContent = `Fiscal End Date: ${formatForDisplay(endDate)}`;
                                    document.getElementById('setfiscalstartyear').textContent = `Fiscal Year : ${formatForDisplay(startDate)}`;
                                    document.getElementById('setfiscalendyear').textContent = `To : ${formatForDisplay(endDate)}`;

                                    // Sync the selected dates in localStorage (client-side)
                                    localStorage.setItem('selectedStartDateLocal', formatForInput(startDate));
                                    localStorage.setItem('selectedEndDateLocal', formatForInput(endDate));
                                    // Now send the updated dates to the backend (session store)
                                    fetch('/update-session-dates', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json',
                                        },
                                        body: JSON.stringify({
                                            startDateLocal: formatForInput(startDate),
                                            endDateLocal: formatForInput(endDate),
                                        }),
                                    })
                                        .then(response => response.json())
                                        .then(data => {
                                            console.log('Session updated:', data);
                                        })
                                        .catch(error => {
                                            console.error('Error updating session:', error);
                                        });



                                });

                                list.appendChild(listItem);
                            });
                        })
                        .catch(error => {
                            console.error('Error fetching fiscal years:', error);
                            document.getElementById('fiscalYearLists').textContent = 'error fetching fiscal years';
                        });

                });

            </script>




