      <td style="text-align:right;">${closingCr.toFixed(2)}</td>
    `;
                        });

                        tableContainer.appendChild(table);
                    }


                    // New function to render tFormat table based on the screenshot structure
                    function renderTFormatTable(data) {
                        const body = document.getElementById("tFormatBody");
                        const footer = document.getElementById("tFormatFooter");
                        body.innerHTML = "";   // clear previous
                        footer.innerHTML = ""; // clear previous

                        if (!data || data.length === 0) {
                            body.innerHTML = `<tr><td colspan="6" style="text-align:center;">⚠️ No data found</td></tr>`;
                            return;
                        }

                        // Grouping helper
                        const groupBySubGroup = (arr) => {
                            const grouped = {};
                            arr.forEach(item => {
                                const key = item.subGroup || item.groupName || "";
                                if (!grouped[key]) {
                                    grouped[key] = { subGroup: item.subGroup || "", subGroupAlias: item.subGroupAlias || "", items: [] };
                                }
                                grouped[key].items.push(item);
                            });
                            return Object.values(grouped);
                        };

                        const liabilitiesGroups = groupBySubGroup(data.filter(d => d.side === "liabilities"));
                        const assetsGroups = groupBySubGroup(data.filter(d => d.side === "assets"));

                        const maxRows = Math.max(liabilitiesGroups.length, assetsGroups.length);

                        for (let i = 0; i < maxRows; i++) {
                            const liabGroup = liabilitiesGroups[i];
                            const assetGroup = assetsGroups[i];

                            const maxInnerRows = Math.max(
                                liabGroup ? liabGroup.items.length : 0,
                                assetGroup ? assetGroup.items.length : 0
                            );

                            for (let j = 0; j < maxInnerRows + 1; j++) {
                                const row = document.createElement("tr");

                                // Liabilities
                                if (liabGroup) {
                                    if (j === 0) {
                                        row.innerHTML += `<td><b style="color:blue;">${liabGroup.subGroup}</b></td>
                                      <td>${liabGroup.subGroupAlias || ""}</td><td></td>`;
                                    } else if (liabGroup.items[j - 1]) {
                                        const item = liabGroup.items[j - 1];
                                        row.innerHTML += `<td>&nbsp;&nbsp;<b>${item.groupName || ""}</b></td>
                                      <td>${item.alias || ""}</td>
                                      <td style="text-align:right;">${formatAmount(item.amount)}</td>`;
                                    } else {
                                        row.innerHTML += "<td></td><td></td><td></td>";
                                    }
                                } else {
                                    row.innerHTML += "<td></td><td></td><td></td>";
                                }

                                // Assets
                                if (assetGroup) {
                                    if (j === 0) {
                                        row.innerHTML += `<td><b style="color:darkblue;">${assetGroup.subGroup}</b></td>
                                      <td>${assetGroup.subGroupAlias || ""}</td><td></td>`;
                                    } else if (assetGroup.items[j - 1]) {
                                        const item = assetGroup.items[j - 1];
                                        row.innerHTML += `<td>&nbsp;&nbsp;<b>${item.groupName || ""}</b></td>
                                      <td>${item.alias || ""}</td>
                                      <td style="text-align:right;">${formatAmount(item.amount)}</td>`;
                                    } else {
                                        row.innerHTML += "<td></td><td></td><td></td>";
                                    }
                                } else {
                                    row.innerHTML += "<td></td><td></td><td></td>";
                                }

                                body.appendChild(row);
                            }
                        }

                        // Totals before balancing
                        let totalLiabilities = data.filter(d => d.side === "liabilities").reduce((sum, d) => sum + (d.amount || 0), 0);
                        let totalAssets = data.filter(d => d.side === "assets").reduce((sum, d) => sum + (d.amount || 0), 0);

                        // --- Balancing figure ---
                        if (totalLiabilities > totalAssets) {
                            const diff = totalLiabilities - totalAssets;
                            const row = document.createElement("tr");
                            row.style.fontWeight = "bold";
                            row.style.backgroundColor = "#ffeeba";
                            row.innerHTML = `
            <td></td><td></td><td></td><td style="color:red;">Balancing Figure (Gross Loss)</td><td></td>
            <td style="text-align:right;">${formatAmount(diff)}</td>
        `;
                            body.appendChild(row);
                            totalAssets += diff;
                        } else if (totalAssets > totalLiabilities) {
                            const diff = totalAssets - totalLiabilities;
                            const row = document.createElement("tr");
                            row.style.fontWeight = "bold";
                            row.style.backgroundColor = "#ffeeba";
                            row.innerHTML = `
           <td style="color:red;">Balancing Figure (Gross Profit)</td><td></td><td style="text-align:right;">${formatAmount(diff)}</td>
            
        `;
                            body.appendChild(row);
                            totalLiabilities += diff;
                        }

                        // --- Final Totals Row ---
                        const totalRow = document.createElement("tr");
                        totalRow.innerHTML = `
        <td colspan="2" style="text-align:right; border-top:2px solid #000;">
            <b style="color:darkorange;">Grand Total</b>
        </td>
        <td style="text-align:right; border-top:2px solid #000;">
            <b style="color:darkorange;">${formatAmount(totalLiabilities)}</b>
        </td>
        <td colspan="2" style="text-align:right; border-top:2px solid #000;">
            <b style="color:darkorange;">Grand Total</b>
        </td>
        <td style="text-align:right; border-top:2px solid #000;">
            <b style="color:darkorange;">${formatAmount(totalAssets)}</b>
        </td>
    `;
                        footer.appendChild(totalRow);

                        function formatAmount(num) {
                            return (num || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    }

                    // Your existing renderFinalAccountTable(data, displayFormat) stays unchanged

                });

            </script>
