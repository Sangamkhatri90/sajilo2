                    // Create and append the close button
                    const closeButton = document.createElement('button');
                    closeButton.textContent = 'X';
                    closeButton.onclick = function (event) {
                        event.preventDefault();
                        penaltyListDiv.style.display = 'none';  // Hide the suggestions list when the close button is clicked
                    };
                    penaltyListDiv.appendChild(closeButton);  // Append the close button to the list

                    if (names.length > 0) {
                        penaltyListDiv.style.display = 'block';  // Show the suggestions list
                        names.forEach(item => {
                            const div = document.createElement('div');
                            div.textContent = `${item.GLName} - ${item.GLAlias}`;  // Show both GLName and GLAlias
                            div.onclick = function () {
                                document.getElementById('PenaltyMasterNew').value = item.GLName;  // Set the input value to GLName
                                penaltyListDiv.style.display = 'none';  // Hide the suggestions list
                            };
                            penaltyListDiv.appendChild(div);
                        });
                    } else {
                        const noResult = document.createElement('div');
                        noResult.textContent = 'No matching GLNames found';
                        penaltyListDiv.appendChild(noResult);
                    }
                }
