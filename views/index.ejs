                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        fetch('/api/nextJournalVoucher')
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error('Network response was not ok: ' + response.status);
                                }
                                return response.json();
                            })
                            .then(data => {
                                if (data.voucherNumber) {
                                    document.getElementById('voucherNumberJVM').value = data.voucherNumber;
                                } else if (data.message) {
                                    document.getElementById('voucherNumberJVM').textContent = 'Error: ' + data.message;
                                } else {
                                    document.getElementById('voucherNumberJVM').textContent = 'Unknown error occurred.';
                                }
                            })
                            .catch(error => {
                                document.getElementById('voucherNumberJVM').textContent = 'Fetch error: ' + error.message;
                            });
                    });
                </script>
