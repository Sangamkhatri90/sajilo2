        </fieldset>
        </form>
    </div>

    <script src="/js/div.js"></script>
    <script>
        let allDocClassForMultiTrans = [];  // Store both DocClassName and DocClassAlias fetched from the server for MultiTrans
        let filteredDocClassForMultiTrans = [];  // Store filtered DocClassNames and DocClassAliases based on user input for MultiTrans
    
        // Function to fetch DocClassNames and DocClassAliases for MultiTrans from the server and display them as suggestions
        function fetchDocClassesForMultiTrans(isInitialFocus) {
            const docClassesList = document.getElementById('docClassesListforMultiTrans');
            docClassesList.innerHTML = '';  // Clear any existing suggestions
            docClassesList.style.display = 'none';  // Hide suggestions list initially
    
            if (allDocClassForMultiTrans.length === 0 || isInitialFocus) {
                // Fetch DocClassNames and DocClassAliases for MultiTrans from the backend if not already fetched
                fetch('/fetchDocClassesForMultiTrans')  // Updated route to reflect the new path
                    .then(response => response.json())
                    .then(data => {
                        if (data.docClasses && data.docClasses.length > 0) {
                            allDocClassForMultiTrans = data.docClasses;  // Store fetched DocClassNames and DocClassAliases for MultiTrans
                            filteredDocClassForMultiTrans = [...allDocClassForMultiTrans];  // Initially show all DocClassNames
                            displayDocClassesForMultiTrans(filteredDocClassForMultiTrans);  // Display the full list on initial focus
                        } else {
                            const noResult = document.createElement('div');
                            noResult.textContent = 'No DocClassNames found';
                            docClassesList.appendChild(noResult);
                        }
                    })
                    .catch(error => {
                        console.error('Error fetching DocClassNames:', error);
                        const errorMessage = document.createElement('div');
                        errorMessage.textContent = 'Error fetching DocClassNames';
                        docClassesList.appendChild(errorMessage);
                    });
            } else {
                displayDocClassesForMultiTrans(filteredDocClassForMultiTrans);  // Display the filtered list
            }
        }
    
        // Function to filter DocClassNames and DocClassAliases based on user input for MultiTrans
        function filterDocClassesForMultiTrans() {
            const input = document.getElementById('doc-class-multi-trans').value.toLowerCase();
            if (input === '') {
                filteredDocClassForMultiTrans = [...allDocClassForMultiTrans];  // Show the full list when input is empty
            } else {
                filteredDocClassForMultiTrans = allDocClassForMultiTrans.filter(item =>
                    item.DocClassName.toLowerCase().includes(input) || item.DocClassAlias.toLowerCase().includes(input)
                );
            }
            displayDocClassesForMultiTrans(filteredDocClassForMultiTrans);
        }
    
        // Function to display DocClassNames and DocClassAliases in the suggestion list for MultiTrans
        function displayDocClassesForMultiTrans(names) {
            const docClassesList = document.getElementById('docClassesListforMultiTrans');
            docClassesList.innerHTML = '';  // Clear previous suggestions
    
            // Create and append the close button
            const closeButton = document.createElement('button');
            closeButton.textContent = 'X';
            closeButton.onclick = function (event) {
                event.preventDefault();
                docClassesList.style.display = 'none';  // Hide the suggestions list when the close button is clicked
            };
            docClassesList.appendChild(closeButton);  // Append the close button to the list
    
            if (names.length > 0) {
                docClassesList.style.display = 'block';  // Show the suggestions list
                names.forEach(item => {
                    const div = document.createElement('div');
                    div.textContent = `${item.DocClassName} - ${item.DocClassAlias}`;  // Show both values
                    div.onclick = function () {
                        document.getElementById('doc-class-multi-trans').value = item.DocClassName;  // Set the input value to DocClassName
                        docClassesList.style.display = 'none';  // Hide the suggestions list
                    };
                    docClassesList.appendChild(div);
                });
            } else {
                const noResult = document.createElement('div');
                noResult.textContent = 'No matching DocClassNames found';
                docClassesList.appendChild(noResult);
            }
        }
    </script>
      <script src="/js/alertsmessages.js"></script>
    
</body>

</html>