    vdcList.sort((a, b) => a.VDC.localeCompare(b.VDC));

    const closeButton = document.createElement('button');
    closeButton.textContent = 'X';
    closeButton.className = 'close-button';

    closeButton.onclick = function (event) {
        event.preventDefault();
        listElement.style.display = 'none';  // Hide the suggestions list
    };

    listElement.appendChild(closeButton);  // Append the close button

    if (vdcList.length > 0) {
        listElement.style.display = 'block';  // Show the suggestions list
        vdcList.forEach(item => {
            const div = document.createElement('div');
            div.className = 'suggestion-item';
            div.textContent = `${item.VDC} - ${item.Alias}`;
            div.title = `${item.VDC} - ${item.Alias}`;

            div.onclick = function () {
                document.getElementById('VDCInput1').value = item.VDC;  // Corrected to VDCInput1
                listElement.style.display = 'none';  // Hide the suggestions list
            };
            listElement.appendChild(div);
        });
    } else {
        const noResult = document.createElement('div');
        noResult.textContent = 'No matching VDCs found';
        noResult.style.color = 'gray';
        listElement.appendChild(noResult);
    }
}

