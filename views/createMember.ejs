        <script>
            // Preview the uploaded image and store its Base64 value in sessionStorage
        function previewImage1(inputId, imgId) {
            const fileInput = document.getElementById(inputId);
            const image = document.getElementById(imgId);
        
            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
        
                reader.onload = function (e) {
                    image.src = e.target.result; // Set the image preview
                    sessionStorage.setItem(inputId + 'Base64', e.target.result); // Store Base64 in sessionStorage
                };
        
                reader.readAsDataURL(fileInput.files[0]);
            }
        }
        
        // Send data to the server
        function updatePhotoAPI() {
            const MemberID = document.getElementById('member-id').value; // Retrieve MemberID
            const photoBase64 = sessionStorage.getItem('photo-inputBase64');
            const sign1Base64 = sessionStorage.getItem('sign1-inputBase64');
            const sign2Base64 = sessionStorage.getItem('sign2-inputBase64');
            const sign3Base64 = sessionStorage.getItem('sign3-inputBase64');
            const sign4Base64 = sessionStorage.getItem('sign4-inputBase64');
        
            if (!MemberID) {
                showCustomAlert('Please enter a Member ID.');
                return;
            }
        
            fetch('/update-photo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    MemberID,
                    photoBase64,
                    sign1Base64,
                    sign2Base64,
                    sign3Base64,
                    sign4Base64
                })
            })
            .then(response => response.text())
            .then(data => {
                showCustomAlert(data); // Show success message
                sessionStorage.clear(); // Clear sessionStorage after successful update
            })
            .catch(error => {
                console.error('Error:', error);
            });
        }
        
        </script>

        <script>
            document.getElementById('intronum1').addEventListener('blur', function () {
              const alias = this.value;
              if (alias.trim() === '') {
                document.getElementById('introname1').value = '';
                return;
              }
          
              fetch('/get-member-name-1', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({ alias }),
              })
                .then((response) => response.json())
                .then((data) => {
                  if (data.success) {
                    document.getElementById('introname1').value = data.memberName || '';
                  } else {
                    showCustomAlert(data.message || 'Member not found');
                  }
                })
                .catch((error) => {
                  console.error('Error:', error);
                });
            });
          </script>
