    <script>
        // Fetch and display profession options
        function fetchProfessionOptions(searchTerm) {
            const professionList = document.getElementById('profession-list');
            if (!searchTerm.trim()) {
                professionList.innerHTML = '';
                return;
            }
            fetch(`/searchProfession?term=${searchTerm}`)
                .then(response => response.json())
                .then(data => {
                    professionList.innerHTML = '';
                    data.forEach(item => {
                        const option = document.createElement('div');
                        option.textContent = item.Profession;
                        option.onclick = () => {
                            document.getElementById('Profession').value = item.Profession;
                            professionList.innerHTML = '';
                        };
                        professionList.appendChild(option);
                    });
                })
                .catch(err => console.error(err));
        }

        // Fetch and display qualification options
        function fetchQualificationOptions(searchTerm) {
            const qualificationList = document.getElementById('qualification-list');
            if (!searchTerm.trim()) {
                qualificationList.innerHTML = '';
                return;
            }
            fetch(`/searchQualification?term=${searchTerm}`)
                .then(response => response.json())
                .then(data => {
                    qualificationList.innerHTML = '';
                    data.forEach(item => {
                        const option = document.createElement('div');
                        option.textContent = item.Qualification;
                        option.onclick = () => {
                            document.getElementById('Qualification').value = item.Qualification;
                            qualificationList.innerHTML = '';
                        };
                        qualificationList.appendChild(option);
                    });
                })
                .catch(err => console.error(err));
        }
    </script>
    <script>
        // Add event listeners to toggle links
        document.addEventListener('DOMContentLoaded', () => {
            const links = document.querySelectorAll('.toggle-link');
            const sections = document.querySelectorAll('#generalInformation, #accounts');
    
            // Initially, show only the first section
            sections.forEach(section => section.style.display = 'none');
            if (sections[0]) sections[0].style.display = 'block';
    
            links.forEach(link => {
                link.addEventListener('click', event => {
                    event.preventDefault();
                    const targetId = link.getAttribute('data-target');
                    const targetSection = document.getElementById(targetId);
    
                    if (targetSection) {
                        // Hide all sections
                        sections.forEach(section => section.style.display = 'none');
                        // Show the targeted section
                        targetSection.style.display = 'block';
    
                        // Update active class
                        links.forEach(link => link.classList.remove('active'));
                        link.classList.add('active');
                    }
                });
            });
        });
    </script>
  
<script>
    let allDistricts1 = [];  // Array to store all district data for the first input
let filteredDistricts1 = [];  // Array to store filtered district data for the first input

// Fetch district data and show suggestions for districtInput
function fetchDistricts1(isInitialFocus) {
    const districtsList = document.getElementById('districtsList');  // List container for districtInput
    const inputField = document.getElementById('districtInput');  // Input field for districtInput
    districtsList.innerHTML = '';  // Clear previous suggestions
    districtsList.style.display = 'none';  // Hide the list initially

    if (allDistricts1.length === 0 || isInitialFocus) {
        fetch('/fetchDistricts1')  // Fetch from the '/fetchDistricts1' endpoint
            .then(response => response.json())
            .then(data => {
                if (data.districts && data.districts.length > 0) {
                    allDistricts1 = data.districts;  // Store all districts in allDistricts1
                    filteredDistricts1 = [...allDistricts1];  // Copy to filteredDistricts1
                    displayDistricts1();
                } else {
                    const noResult = document.createElement('div');
                    noResult.textContent = 'No districts found';
                    noResult.style.color = 'gray';
                    districtsList.appendChild(noResult);
                }
            })
            .catch(error => {
                console.error('Error fetching districts:', error);
                const errorMessage = document.createElement('div');
                errorMessage.textContent = 'Error fetching districts';
                errorMessage.style.color = 'red';
                districtsList.appendChild(errorMessage);
            });
    } else {
        displayDistricts1();  // Use filteredDistricts1 when available
    }
}

// Filter districts based on user input for districtInput
function filterDistricts1() {
    const input = document.getElementById('districtInput').value.toLowerCase();
    if (input === '') {
        filteredDistricts1 = [...allDistricts1];  // Reset filteredDistricts1 to allDistricts1
    } else {
        filteredDistricts1 = allDistricts1.filter(item =>
            item.District.toLowerCase().includes(input) || item.Alias.toLowerCase().includes(input)
        );
    }
    displayDistricts1();
}

// Display the filtered districts in the suggestions list for districtInput
function displayDistricts1() {
    const districtsList = document.getElementById('districtsList');
    districtsList.innerHTML = '';  // Clear previous suggestions

    // Sort the districts alphabetically by District name
    filteredDistricts1.sort((a, b) => a.District.localeCompare(b.District));

    const closeButton = document.createElement('button');
    closeButton.textContent = 'X';
    closeButton.className = 'close-button';

    closeButton.onclick = function (event) {
        event.preventDefault();
        districtsList.style.display = 'none';  // Hide the suggestions list
    };

    districtsList.appendChild(closeButton);  // Append the close button

    if (filteredDistricts1.length > 0) {
        districtsList.style.display = 'block';  // Show the suggestions list
        filteredDistricts1.forEach(item => {
            const div = document.createElement('div');
            div.className = 'suggestion-item';
            div.textContent = `${item.District} - ${item.Alias}`;
            div.title = `${item.District} - ${item.Alias}`;

            div.onclick = function () {
                document.getElementById('districtInput').value = item.District;  // Populate the input field
                districtsList.style.display = 'none';  // Hide the suggestions list
            };
            districtsList.appendChild(div);
        });
    } else {
        const noResult = document.createElement('div');
        noResult.textContent = 'No matching districts found';
        noResult.style.color = 'gray';
        districtsList.appendChild(noResult);
    }
}

</script>
