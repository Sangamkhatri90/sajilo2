<script>
    let allVDCs1 = [];  // Array to store all VDC data
let filteredVDCs1 = [];  // Array to store filtered VDC data

// Fetch VDC data and show suggestions
function fetchVDC1(isInitialFocus) {
    const vdcList = document.getElementById('VDCList1');  // Corrected to VDCList1
    const inputField = document.getElementById('VDCInput1');
    vdcList.innerHTML = '';  // Clear previous suggestions
    vdcList.style.display = 'none';  // Hide the list initially

    if (allVDCs1.length === 0 || isInitialFocus) {
        fetch('/fetchVDC1')  // Fetch from the '/fetchVDC1' endpoint
            .then(response => response.json())
            .then(data => {
                if (data.vdc && data.vdc.length > 0) {
                    allVDCs1 = data.vdc;  // Store all VDCs in allVDCs1
                    filteredVDCs1 = [...allVDCs1];  // Copy to filteredVDCs1
                    displayVDCs1(filteredVDCs1);
                } else {
                    const noResult = document.createElement('div');
                    noResult.textContent = 'No VDCs found';
                    noResult.style.color = 'gray';
                    vdcList.appendChild(noResult);
                }
            })
            .catch(error => {
                console.error('Error fetching VDC data:', error);
                const errorMessage = document.createElement('div');
                errorMessage.textContent = 'Error fetching VDC data';
                errorMessage.style.color = 'red';
                vdcList.appendChild(errorMessage);
            });
    } else {
        displayVDCs1(filteredVDCs1);  // Use filteredVDCs1 when available
    }
}

// Filter VDCs based on user input
function filterVDCs1() {
    const input = document.getElementById('VDCInput1').value.toLowerCase();  // Corrected to VDCInput1
    if (input === '') {
        filteredVDCs1 = [...allVDCs1];  // Reset filteredVDCs1 to allVDCs1
    } else {
        filteredVDCs1 = allVDCs1.filter(item =>
            item.VDC.toLowerCase().includes(input) || item.Alias.toLowerCase().includes(input)
        );
    }
    displayVDCs1(filteredVDCs1);
}

// Display the filtered VDCs in the suggestions list
function displayVDCs1(vdcList) {
