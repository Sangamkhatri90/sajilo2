        <script>
            // Preview the uploaded image and store its Base64 value in sessionStorage
        function previewImage1(inputId, imgId) {
            const fileInput = document.getElementById(inputId);
            const image = document.getElementById(imgId);
        
            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
        
                reader.onload = function (e) {
                    image.src = e.target.result; // Set the image preview
                    sessionStorage.setItem(inputId + 'Base64', e.target.result); // Store Base64 in sessionStorage
                };
        
                reader.readAsDataURL(fileInput.files[0]);
            }
        }
        
        // Send data to the server
        function updatePhotoAPI() {
            const MemberID = document.getElementById('member-id').value; // Retrieve MemberID
            const photoBase64 = sessionStorage.getItem('photo-inputBase64');
            const sign1Base64 = sessionStorage.getItem('sign1-inputBase64');
            const sign2Base64 = sessionStorage.getItem('sign2-inputBase64');
            const sign3Base64 = sessionStorage.getItem('sign3-inputBase64');
            const sign4Base64 = sessionStorage.getItem('sign4-inputBase64');
        
            if (!MemberID) {
                showCustomAlert('Please enter a Member ID.');
                return;
            }
        
            fetch('/update-photo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    MemberID,
                    photoBase64,
                    sign1Base64,
                    sign2Base64,
                    sign3Base64,
                    sign4Base64
                })
            })
            .then(response => response.text())
            .then(data => {
                showCustomAlert(data); // Show success message
                sessionStorage.clear(); // Clear sessionStorage after successful update
            })
            .catch(error => {
                console.error('Error:', error);
            });
        }
        
        </script>
        <script>
  function attachMemberLookup({ aliasInputId, nameInputId, url }) {
    const aliasEl = document.getElementById(aliasInputId);
    const nameEl = document.getElementById(nameInputId);
    if (!aliasEl || !nameEl) return;

    aliasEl.addEventListener('blur', function () {
      const alias = this.value.trim();

      if (alias === '') {
        nameEl.value = '';
        return;
      }

      fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ alias }),
      })
        .then((response) => response.json())
        .then((data) => {
          if (data.success) {
            nameEl.value = data.memberName || '';
          } else {
            nameEl.value = '';
            showCustomAlert(data.message || 'Member not found');
          }
        })
        .catch((error) => {
          console.error('Error:', error);
        });
    });
  }

  // Usage: one line per field pair
  attachMemberLookup({
    aliasInputId: 'intronum1',
    nameInputId: 'introname1',
    url: '/get-member-name-1',
  });

  // Add more pairs the same way
  attachMemberLookup({
    aliasInputId: 'intronum2',
    nameInputId: 'introname2',
    url: '/get-member-name-1',
  });
</script>

    <script>
        // Add event listeners to toggle links
        document.addEventListener('DOMContentLoaded', () => {
            const links = document.querySelectorAll('.toggle-link');
            const sections = document.querySelectorAll('#generalInformation, #accounts, #others');
    
            // Initially, show only the first section
            sections.forEach(section => section.style.display = 'none');
            if (sections[0]) sections[0].style.display = 'block';
    
            links.forEach(link => {
                link.addEventListener('click', event => {
                    event.preventDefault();
                    const targetId = link.getAttribute('data-target');
                    const targetSection = document.getElementById(targetId);
    
                    if (targetSection) {
                        // Hide all sections
                        sections.forEach(section => section.style.display = 'none');
                        // Show the targeted section
                        targetSection.style.display = 'block';
    
                        // Update active class
                        links.forEach(link => link.classList.remove('active'));
                        link.classList.add('active');
                    }
                });
            });

            if (links[0]) links[0].classList.add('active');

            const statusSelect = document.getElementById('Status');
            if (statusSelect) {
                statusSelect.addEventListener('change', () => {
                    if (statusSelect.value === 'left') {
                        alert('A new member cannot be set to Left.');
                        statusSelect.value = 'live';
                    }
                });
            }

            document.querySelectorAll('.member-close-button').forEach(button => {
                button.addEventListener('click', () => {
                    const parentPanel = window.parent.document.getElementById('movableDiv194');
                    if (parentPanel) parentPanel.style.display = 'none';
                });
            });

            const dragHandle = document.querySelector('.member-form-header');
            if (dragHandle) {
                dragHandle.addEventListener('mousedown', event => {
                    if (event.button !== 0 || event.target.closest('button')) return;

                    const parentPanel = window.parent.document.getElementById('movableDiv194');
                    if (!parentPanel) return;

                    event.preventDefault();
                    const panelRect = parentPanel.getBoundingClientRect();
                    const offsetX = event.clientX - panelRect.left;
                    const offsetY = event.clientY - panelRect.top;

                    const movePanel = moveEvent => {
                        const rect = parentPanel.getBoundingClientRect();
                        const margin = 8;
                        const maxLeft = Math.max(margin, window.parent.innerWidth - rect.width - margin);
                        const maxTop = Math.max(margin, window.parent.innerHeight - rect.height - margin);
                        parentPanel.style.left = `${Math.min(Math.max(moveEvent.clientX - offsetX, margin), maxLeft)}px`;
                        parentPanel.style.top = `${Math.min(Math.max(moveEvent.clientY - offsetY, margin), maxTop)}px`;
                    };

                    const stopMoving = () => {
                        document.removeEventListener('mousemove', movePanel);
                        document.removeEventListener('mouseup', stopMoving);
                    };

                    document.addEventListener('mousemove', movePanel);
                    document.addEventListener('mouseup', stopMoving);
                });
            }
        });
    </script>

    

