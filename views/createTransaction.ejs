      } else {
          filteredCollectors = allCollectors.filter(item =>
              item.CollectorName.toLowerCase().includes(input) || item.CollectorAlias.toLowerCase().includes(input)
          );
      }
      displayCollectors(filteredCollectors);
  }

  // Display the filtered collectors in the suggestions list
  function displayCollectors(collectors) {
      const collectorsList = document.getElementById('PCollectorsList');  // Corrected to PCollectorsList
      collectorsList.innerHTML = '';  // Clear previous suggestions

      // Sort the collectors alphabetically by CollectorName
      collectors.sort((a, b) => a.CollectorName.localeCompare(b.CollectorName));

      // Create and append the close button to hide the suggestions list
      const closeButton = document.createElement('button');
      closeButton.textContent = 'X';
      closeButton.className = 'close-button';

      closeButton.onclick = function (event) {
          event.preventDefault();
          collectorsList.style.display = 'none';  // Hide the suggestions list
      };

      collectorsList.appendChild(closeButton);  // Append the close button

      if (collectors.length > 0) {
          collectorsList.style.display = 'block';  // Show the suggestions list
          collectors.forEach(item => {
              const div = document.createElement('div');
              div.className = 'suggestion-item';
              div.textContent = `${item.CollectorName} - ${item.CollectorAlias}`;
              div.title = `${item.CollectorName} - ${item.CollectorAlias}`;

              div.onclick = function () {
                  document.getElementById('PCollector').value = item.CollectorName;  // Corrected to PCollector
                  collectorsList.style.display = 'none';  // Hide the suggestions list
              };
              collectorsList.appendChild(div);
          });
      } else {
          const noResult = document.createElement('div');
          noResult.textContent = 'No matching collectors found';
          noResult.style.color = 'gray';
          collectorsList.appendChild(noResult);
      }
  }

</script>



