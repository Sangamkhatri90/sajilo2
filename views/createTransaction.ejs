<script>
  // Function to fetch member name
  function fetchSubName(alias) {
    fetch('/get-member-alias-3', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ alias }),
    })
      .then((response) => response.json())
      .then((data) => {
        const memberNameDisplay = document.getElementById('SubName-1');
        if (data.success) {
          memberNameDisplay.value= data.memberName;
        } else {
          memberNameDisplay.value = data.message || 'Error fetching data';
        }
      })
      .catch((error) => {
        console.error('Error:', error);
      });
  }

  // On page load, fetch initial value
  document.addEventListener('DOMContentLoaded', () => {
    const initialAlias = document.getElementById('SubAlias-1').value || 'defaultAlias'; // Set a default alias or handle it dynamically
    fetchSubName(initialAlias);
  });

