  <script>
    // Function to fetch member name
    function fetchMemberName(alias) {
      fetch('/get-member-name-3', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ alias }),
      })
        .then((response) => response.json())
        .then((data) => {
          const memberNameDisplay = document.getElementById('MemberName');
          if (data.success) {
            memberNameDisplay.value= data.memberName;
          } else {
            memberNameDisplay.value = data.message || 'Error fetching data';
          }
        })
        .catch((error) => {
          console.error('Error:', error);
        });
    }
  
    // On page load, fetch initial value
    document.addEventListener('DOMContentLoaded', () => {
      const initialAlias = document.getElementById('MemberAlias').value || 'defaultAlias'; // Set a default alias or handle it dynamically
      fetchMemberName(initialAlias);
    });
  
    // Handle blur event on input
    document.getElementById('MemberAlias').addEventListener('blur', (event) => {
      const alias = event.target.value;
      if (alias) {
        fetchMemberName(alias);
      }
    });
  

  </script>
  
