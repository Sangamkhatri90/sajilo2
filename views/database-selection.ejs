<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Database - Sajilo Cooperative</title>
    <link rel="stylesheet" href="/css/index.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <style>
        #toast {
            visibility: hidden;
            min-width: 260px;
            background-color: #333;
            color: #fff;
            text-align: center;
            border-radius: 8px;
            padding: 10px 20px;
            position: fixed;
            z-index: 9999;
            left: 50%;
            bottom: 30px;
            transform: translateX(-50%);
            font-size: 15px;
            opacity: 0;
            transition: opacity 0.4s, visibility 0.4s;
        }
        #toast.show {
            visibility: visible;
            opacity: 1;
        }
        body {
            justify-content: center;
            padding: 24px;
            color: var(--white);
        }
        .selection-container {
            width: min(920px, 100%);
            max-height: calc(100vh - 48px);
            margin: 0 auto;
            padding: 28px 32px;
            background-color: rgba(0, 0, 0, 0.72);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 12px;
            box-shadow: 0 18px 48px rgba(0, 0, 0, 0.35);
            animation: fadeIn 0.5s ease-in-out;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .table-wrap {
            overflow: auto;
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 8px;
            background-color: rgba(255, 255, 255, 0.08);
        }
        .org-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
            color: var(--white);
        }
        .org-table thead {
            background-color: rgba(195, 56, 56, 0.95);
        }
        .org-table th {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            font-weight: bold;
            position: sticky;
            top: 0;
            z-index: 1;
        }
        .org-table td {
            padding: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.14);
            color: rgba(255, 255, 255, 0.92);
        }
        .org-table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.16);
            cursor: pointer;
        }
        .org-table tbody tr.selected {
            background-color: rgba(75, 140, 217, 0.55);
        }
        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            justify-content: center;
        }
        .button-group button {
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
        }
        .btn-continue {
            background-color: #4CAF50;
            color: white;
        }
        .btn-continue:hover {
            background-color: #45a049;
        }
        .btn-logout {
            background-color: #f44336;
            color: white;
        }
        .btn-logout:hover {
            background-color: #da190b;
        }
        .welcome-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .welcome-header h1 {
            margin: 0 0 10px 0;
        }
        .welcome-header p {
            margin: 0;
            color: rgba(255, 255, 255, 0.78);
        }
        .loading-cell,
        .empty-cell {
            text-align: center;
            padding: 28px 12px !important;
            color: rgba(255, 255, 255, 0.82) !important;
        }
        .loading-state {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }
        .loading-spinner {
            width: 18px;
            height: 18px;
            border: 3px solid rgba(255, 255, 255, 0.25);
            border-top-color: #ffffff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        @media (max-width: 700px) {
            body {
                padding: 14px;
            }
            .selection-container {
                padding: 20px 14px;
            }
            .org-table th,
            .org-table td {
                padding: 10px 8px;
                font-size: 13px;
            }
        }
    </style>
</head>
<body>
    <div class="selection-container">
        <div class="welcome-header">
            <h1>Select Database</h1>
            <p>Welcome, <strong><%= username %></strong>. Please select an organization and fiscal year to continue.</p>
        </div>

        <div class="table-wrap">
            <table class="org-table">
                <thead>
                    <tr>
                        <th>Organization</th>
                        <th>Fiscal Year</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                    </tr>
                </thead>
                <tbody id="orgTableBody">
                    <tr>
                        <td colspan="4" class="loading-cell">
                            <span class="loading-state">
                                <span class="loading-spinner" aria-hidden="true"></span>
                                Loading databases...
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="button-group">
            <button type="button" class="btn-continue" id="continueBtn">Continue</button>
            <button type="button" class="btn-logout" id="logoutBtn">Logout</button>
        </div>
    </div>

    <div id="toast"></div>

    <script>
        let selectedOrgData = null;

        document.addEventListener('DOMContentLoaded', async () => {
            await loadOrganizations();
            setupEventListeners();
        });

        async function loadOrganizations() {
            const tableBody = document.getElementById('orgTableBody');
            tableBody.innerHTML = `
                <tr>
                    <td colspan="4" class="loading-cell">
                        <span class="loading-state">
                            <span class="loading-spinner" aria-hidden="true"></span>
                            Loading databases...
                        </span>
                    </td>
                </tr>
            `;

            try {
                const response = await fetch('/fetch-fiscal-data');
                if (!response.ok) throw new Error('Failed to fetch organizations');
                
                const data = await response.json();
                populateTable(data);
            } catch (error) {
                console.error('Error loading organizations:', error);
                tableBody.innerHTML = '<tr><td colspan="4" class="empty-cell">Unable to load databases. Please refresh the page.</td></tr>';
                showToast('❌ Failed to load organizations. Please refresh the page.');
            }
        }

        function populateTable(data) {
            const tableBody = document.getElementById('orgTableBody');
            tableBody.innerHTML = '';

            if (!Array.isArray(data) || data.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="4" class="empty-cell">No databases found.</td></tr>';
                return;
            }

            data.forEach((org) => {
                const row = document.createElement('tr');
                row.setAttribute('data-orgid', org.orgid);
                row.setAttribute('data-dbname', org.orgDb);
                row.setAttribute('data-startdate', org.startDate);
                row.setAttribute('data-enddate', org.endDate);
                row.setAttribute('data-orgname', org.orgName);

                const getFiscalYear = (date) => {
                    if (!date || date === 'No date found') return 'Unknown';

                    const parts = String(date).trim().split(/[/-]/);
                    if (parts.length !== 3) return 'Unknown';

                    // Supports YYYY-MM-DD and DD/MM/YYYY values returned by the API.
                    return parts[0].length === 4 ? parts[0] : parts[2];
                };

                const startYear = getFiscalYear(org.startDate);
                const endYear = getFiscalYear(org.endDate);
                const fiscalYear = `${startYear}-${endYear}`;

                row.innerHTML = `
                    <td>${org.orgName || 'N/A'}</td>
                    <td>${fiscalYear}</td>
                    <td>${org.startDate}</td>
                    <td>${org.endDate}</td>
                `;

                row.addEventListener('click', () => selectRow(row, org));
                tableBody.appendChild(row);
            });
        }

        function selectRow(row, orgData) {
            // Remove previous selection
            document.querySelectorAll('.org-table tbody tr').forEach(r => r.classList.remove('selected'));
            
            // Add selection to clicked row
            row.classList.add('selected');
            selectedOrgData = orgData;
        }

        function setupEventListeners() {
            document.getElementById('continueBtn').addEventListener('click', () => {
                if (!selectedOrgData) {
                    showToast('⚠️ Please select an organization first.');
                    return;
                }
                submitSelection();
            });

            document.getElementById('logoutBtn').addEventListener('click', () => {
                logout();
            });
        }

        function submitSelection() {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/select-database';

            const fields = {
                dbName: selectedOrgData.orgDb,
                startDateInput: selectedOrgData.startDate,
                endDateInput: selectedOrgData.endDate
            };

            Object.keys(fields).forEach(key => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = fields[key];
                form.appendChild(input);
            });

            document.body.appendChild(form);
            form.submit();
        }

        async function logout() {
            try {
                await fetch('/logout', { method: 'POST' });
                window.location.href = '/login';
            } catch (error) {
                console.error('Logout error:', error);
                window.location.href = '/login';
            }
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = 'show';
            setTimeout(() => (toast.className = toast.className.replace('show', '')), 3000);
        }
    </script>
</body>
</html>
